#
# PROVIDE: ember_pkg_update
# REQUIRE: LOGIN NETWORKING syslogd
# KEYWORD: shutdown

$_rc_subr_loaded . /etc/rc.subr

name=ember_pkg_update
rcvar=$name
pidfile=/var/run/${name}.pid
python=/usr/pkg/bin/python3.15
client=/usr/local/libexec/ember-sdk.pyz
config=/usr/local/etc/ember-sdk.json
start_cmd=ember_pkg_update_start
status_cmd=ember_pkg_update_status
stop_cmd=ember_pkg_update_stop
extra_commands=status

ember_pkg_update_pid()
{
	# A stopped or crashed controller leaves an unlocked pidfile. Only a
	# locked pidfile naming the SDK controller grants authority to signal.
	/usr/bin/pgrep -L -F "$pidfile" -f '/ember-sdk[.]pyz --config [^ ]+ auto-update$' 2>/dev/null
}

ember_pkg_update_status()
{
	local pid
	if pid=$(ember_pkg_update_pid); then
		echo "$name is running as pid $pid."
	else
		echo "$name is not running."
		return 1
	fi
}

ember_pkg_update_start()
{
	local file
	for file in "$client" "$config"; do
		[ -r "$file" ] || { warn "Cannot read $file"; return 1; }
	done
	[ -x "$python" ] || { warn "Cannot execute $python"; return 1; }
	echo "Starting $name."
	# Open the pidfile before spawning. The controller inherits its lock,
	# whereas the logger and package tools do not own it.
	"$python" -I - "$pidfile" "$name" "$client" "$config" <<'PY'
import fcntl
import subprocess
import sys

pid_path, name, client, config = sys.argv[1:]
with open(pid_path, "a+", encoding="ascii") as pidfile:
    try:
        fcntl.flock(pidfile, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        sys.exit(f"{name} is already running.")
    pidfile.truncate(0)
    log = subprocess.Popen(["/usr/bin/logger", "-p", "daemon.info", "-t", name],
                           stdin=subprocess.PIPE, stdout=subprocess.DEVNULL,
                           stderr=subprocess.DEVNULL, start_new_session=True)
    with log.stdin:
        child = subprocess.Popen([sys.executable, "-u", client, "--config", config,
                                  "auto-update"], stdin=subprocess.DEVNULL,
                                 stdout=log.stdin, stderr=subprocess.STDOUT, cwd="/",
                                 pass_fds=(pidfile.fileno(),), start_new_session=True)
    try:
        pidfile.write(f"{child.pid}\n")
        pidfile.flush()
    except OSError:
        child.terminate()
        child.wait()
        raise
PY
}

ember_pkg_update_stop()
{
	local pid
	if ! pid=$(ember_pkg_update_pid); then
		echo "$name is not running."
		return 1
	fi
	echo "Stopping $name."
	kill -TERM "$pid" || return 1
	wait_for_pids "$pid"
}

case "$1" in
*start)
	if [ -x /etc/rc.d/ember_update ] && /etc/rc.d/ember_update owns-legacy; then
		exit 0
	fi
	;;
esac

load_rc_config "$name"
run_rc_command "$1"
