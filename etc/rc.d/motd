#!/bin/sh
#
# $NetBSD: motd,v 1.11 2020/09/11 12:50:14 kim Exp $
# Origin: EmberBSD repeatable product greeting, prepared with AI assistance.
#

# PROVIDE: motd
# REQUIRE: mountcritremote
# BEFORE:  LOGIN

$_rc_subr_loaded . /etc/rc.subr

name="motd"
rcvar="update_motd"
start_cmd="motd_start"
stop_cmd=":"

motd_start()
{
	#	Update product release info in /etc/motd
	#	Must be done *before* interactive logins are possible
	#	to prevent possible race conditions.
	#
	echo "Updating motd."
	if [ ! -f /etc/motd ]; then
		install -c -o root -g wheel -m 664 /dev/null /etc/motd
	fi
	( umask 022
	T=/etc/_motd
	local release t
	# /etc/release retains full attribution; only its product header is shown.
	release="$(sed -n '1{/^EmberBSD /p;}' /etc/release)"
	[ -n "$release" ] || release="EmberBSD"
	printf '%s\n' "$release" > $T
	if checkyesno update_motd_release; then
		t="$(echo "${motd_release_tag%%:*}" | tr -d /)"
		sed -En '/^ *Build ID */{s//Build: /;p;q;}' \
		    < /etc/release | sed "s/^/${t:+${t}: }/" >> $T
	fi
	# Remove only generated leading identity lines, preserving local notices.
	sed -E '1,3{/^([^:]*: )?(NetBSD|EmberBSD)( |$)/d;
	    /^([^:]*: )?Build: /d;}
	    s/^Welcome to NetBSD!$/Welcome to EmberBSD!/' < /etc/motd >> $T
	cmp -s $T /etc/motd || cp $T /etc/motd
	rm -f $T
	)
}

load_rc_config $name
run_rc_command "$1"
