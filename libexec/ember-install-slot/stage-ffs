#!/bin/sh
# SPDX-License-Identifier: BSD-2-Clause
# Private mount lifecycle for ember-install-slot. The caller checks both wedges.
set -eu
PATH=/sbin:/usr/sbin:/bin:/usr/bin
export PATH
umask 077
# postinstall uses the successor's obsolete list. An unattended slot also
# checks the previous set's file digest before removing a site-owned copy.
obsolete_base()
{
	root=$1 archive=$2 work=$3
	leaf=./usr/libexec/ember-os-update
	file=$root/${leaf#./}
	old=$root/etc/mtree/set.base
	[ "$root" != / ] && [ "$(realpath "$root")" = "$root" ] || return 1
	for dir in "$root/etc" "$root/etc/mtree" "$root/usr" "$root/usr/libexec"; do
		[ -d "$dir" ] && [ ! -L "$dir" ] || return 0
	done
	[ -f "$file" ] && [ ! -L "$file" ] && [ -f "$old" ] && [ ! -L "$old" ] || return 0
	digest=$(awk -v file="$leaf" -v mode="mode=0$(stat -f %Lp "$file")" '
	    $1 == file {
	      for (i=2; i<=NF; i++) {
	        if ($i=="type=file") reg=1
	        if ($i=="uname=root") owner=1
	        if ($i=="gname=wheel") group=1
	        if ($i==mode) same=1
	        if ($i ~ /^sha256=/) hash=substr($i,8)
	      }
	      if (reg && owner && group && same) print hash
	      exit
	    }' "$old")
	[ -n "$digest" ] && [ "$(stat -f '%u:%g' "$file")" = 0:0 ] &&
	    [ "$(sha256 -q "$file")" = "$digest" ] || return 0
	scratch=$(mktemp -d "$work/obsolete.XXXXXXXX")
	trap 'rm -rf "$scratch"' EXIT HUP INT TERM
	if ! tar -xf "$archive" -C "$scratch" ./etc/mtree/set.base ./var/db/obsolete/base; then
		return 0
	fi
	[ -f "$scratch/etc/mtree/set.base" ] && [ ! -L "$scratch/etc/mtree/set.base" ] &&
	    [ -f "$scratch/var/db/obsolete/base" ] && [ ! -L "$scratch/var/db/obsolete/base" ] || return 1
	if awk -v file="$leaf" '$1==file { found=1 } END { exit !found }' "$scratch/etc/mtree/set.base"; then
		return 0
	fi
	if grep -Fxq "$leaf" "$scratch/var/db/obsolete/base"; then
		rm "$file"
	fi
}

if [ "$1" = obsolete-base ]; then
	[ "$#" -eq 4 ] || exit 2
	obsolete_base "$2" "$3" "$4"
	exit $?
fi

# Print literal snapshot paths in traversal order. Keep empty mount points.
if [ "$1" = snapshot-paths ]; then
	[ "$#" -eq 2 ] || exit 2
	cd "$2"
	export LC_ALL=C
	exec find -sx . \( \
	    -path './boot/?*' -o -path './tmp/?*' -o -path './proc/?*' -o \
	    -path './dev/pts/?*' -o -path './var/tmp/?*' -o -path './var/run/?*' -o \
	    -path './var/cache/?*' -o -path './var/shm/?*' -o \
	    -path './var/db/ember-update/incoming' -o -path './var/db/ember-os-update/incoming' -o \
	    -path './var/db/ember-os-update/attempt.json' -o -path './var/db/ember-update/attempt.json' -o \
	    -path './var/db/emberbsd-sdk/client.lock' \) -prune -o -print0
fi

[ "$#" -eq 6 ] || exit 2
case "$3:$4" in packages:prepare|full:prepare|full:prepare-kernel) ;; *) exit 2 ;; esac
case "$5" in A|B) ;; *) exit 2 ;; esac
work=$1
device=$2
method=$3
shift 3
root=$work/root
snap=$work/snapshot
fst=
writer=
remove_mountpoint()
{
	# A signal can arrive after mount succeeds and before the shell resumes.
	if rmdir "$1" 2>/dev/null; then return 0; fi
	[ -n "$2" ] && [ ! -L "$1" ] || return 1
	entry=$(df -PM -t ffs "$1") || return 1
	printf '%s\n' "$entry" | awk -v point="$1" -v device="$2" \
	    'NR == 2 && NF == 6 && $1 == device && $6 == point { found=1 }
	     END { exit !(found && NR == 2) }' || return 1
	umount "$1" && rmdir "$1"
}
change_snapshot()
{
	# Finish the ioctl and record ownership before honoring a stop request.
	interrupted=
	trap 'interrupted=yes' HUP INT TERM
	(trap '' HUP INT TERM; fssconfig "$@")
	case "$1" in -x) fst=$2 ;; -u) fst= ;; esac
	trap 'exit 1' HUP INT TERM
	[ -z "$interrupted" ]
}
finish()
{
	result=$?
	trap - EXIT
	trap '' HUP INT TERM
	if [ -n "$writer" ]; then kill "$writer" 2>/dev/null || :; wait "$writer" || :; fi
	remove_mountpoint "$snap" "${fst:+/dev/$fst}" || exit 1
	if [ -n "$fst" ]; then fssconfig -u "$fst" || exit 1; fi
	remove_mountpoint "$root" "$device" || exit 1
	rm -rfx "$work" || exit 1
	exit "$result"
}
# Arm recursive cleanup only after both directories exist.
mkdir "$root" "$snap"
trap finish EXIT
trap 'exit 1' HUP INT TERM
fstdev=$(fssconfig -l | awk '/^fss[0-9]+: not in use$/ { sub(/:$/, "", $1); print $1; exit }')
[ -n "$fstdev" ] || { echo 'No free FFS snapshot device' >&2; exit 1; }
change_snapshot -x "$fstdev" / "$work/backing"
mount -r -t ffs "/dev/$fst" "$snap"
copy_tree()
{
	(cd "$snap" && exec tar --one-file-system -cpf - --null --no-recursion -T "$1") >"$work/tree" &
	writer=$!
	ok=0
	if ! tar -xpf "$work/tree" -C "$root"; then
		ok=1
		kill "$writer" 2>/dev/null || :
	fi
	wait "$writer" || ok=1
	writer=
	return "$ok"
}

"$0" snapshot-paths "$snap" >"$work/paths"
mkfifo "$work/tree"
raw=/dev/r${device##*/}
copied=
if [ "$method" = packages ] && fsck_ffs -n "$raw" &&
    mount -t ffs -o async,noatime "$device" "$root"; then
	if /usr/libexec/ember-install-slot delta "$2" "$work" <"$work/paths" >"$work/changed"; then
		if copy_tree "$work/changed"; then copied=yes; fi
	else
		rc=$?
		[ "$rc" -eq 3 ] || exit "$rc"
	fi
	if [ -z "$copied" ]; then
		logger -s -t ember-install-slot 'Cannot reuse the inactive FFS. Rebuild it from the snapshot.' || :
		umount "$root"
	fi
fi
if [ -z "$copied" ]; then
	newfs -O 1 "$raw"
	mount -t ffs -o async,noatime "$device" "$root"
	copy_tree "$work/paths"
fi
umount "$snap"
change_snapshot -u "$fst"
/usr/libexec/ember-install-slot populate "$root" "$@"
chroot "$root" /bin/sh -ec '
    for dir in /boot /tmp /var/run /var/tmp; do test -d "$dir"; done
    test -x /usr/sbin/ember-update
    test -x /etc/rc.d/ember_update
    /usr/sbin/ember-update --help >/dev/null
    . /etc/rc.subr
    load_rc_config resize_root
    ! checkyesno resize_root || exit 1
    load_rc_config resize_gpt
    ! checkyesno resize_gpt || exit 1
'
sync
umount "$root"
