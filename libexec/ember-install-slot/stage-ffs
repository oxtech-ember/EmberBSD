#!/bin/sh
# SPDX-License-Identifier: BSD-2-Clause
# Private mount lifecycle for ember-install-slot. The caller checks both wedges.
set -eu
PATH=/sbin:/usr/sbin:/bin:/usr/bin
export PATH
umask 077
# postinstall uses the successor's obsolete list. An unattended slot also
# checks the previous set's file digest before removing a site-owned copy.
obsolete_base()
{
	root=$1 archive=$2 work=$3
	leaf=./usr/libexec/ember-os-update
	file=$root/${leaf#./}
	old=$root/etc/mtree/set.base
	[ "$root" != / ] && [ "$(realpath "$root")" = "$root" ] || return 1
	for dir in "$root/etc" "$root/etc/mtree" "$root/usr" "$root/usr/libexec"; do
		[ -d "$dir" ] && [ ! -L "$dir" ] || return 0
	done
	[ -f "$file" ] && [ ! -L "$file" ] && [ -f "$old" ] && [ ! -L "$old" ] || return 0
	digest=$(awk -v file="$leaf" -v mode="mode=0$(stat -f %Lp "$file")" '
	    $1 == file {
	      for (i=2; i<=NF; i++) {
	        if ($i=="type=file") reg=1
	        if ($i=="uname=root") owner=1
	        if ($i=="gname=wheel") group=1
	        if ($i==mode) same=1
	        if ($i ~ /^sha256=/) hash=substr($i,8)
	      }
	      if (reg && owner && group && same) print hash
	      exit
	    }' "$old")
	[ -n "$digest" ] && [ "$(stat -f '%u:%g' "$file")" = 0:0 ] &&
	    [ "$(sha256 -q "$file")" = "$digest" ] || return 0
	scratch=$(mktemp -d "$work/obsolete.XXXXXXXX")
	trap 'rm -rf "$scratch"' EXIT HUP INT TERM
	if ! tar -xf "$archive" -C "$scratch" ./etc/mtree/set.base ./var/db/obsolete/base; then
		return 0
	fi
	[ -f "$scratch/etc/mtree/set.base" ] && [ ! -L "$scratch/etc/mtree/set.base" ] &&
	    [ -f "$scratch/var/db/obsolete/base" ] && [ ! -L "$scratch/var/db/obsolete/base" ] || return 1
	if awk -v file="$leaf" '$1==file { found=1 } END { exit !found }' "$scratch/etc/mtree/set.base"; then
		return 0
	fi
	if grep -Fxq "$leaf" "$scratch/var/db/obsolete/base"; then
		rm "$file"
	fi
}

if [ "$1" = obsolete-base ]; then
	[ "$#" -eq 4 ] || exit 2
	obsolete_base "$2" "$3" "$4"
	exit $?
fi

work=$1
device=$2
shift 2
root=$work/root
snap=$work/snapshot
fst=
target_mounted=
snap_mounted=
writer=
finish()
{
	result=$?
	trap - EXIT HUP INT TERM
	if [ -n "$writer" ]; then kill "$writer" 2>/dev/null || :; wait "$writer" || :; fi
	if [ -n "$snap_mounted" ]; then umount "$snap" || exit 1; fi
	if [ -n "$fst" ]; then fssconfig -u "$fst" || exit 1; fi
	if [ -n "$target_mounted" ]; then umount "$root" || exit 1; fi
	rm -rf "$work"
	exit "$result"
}
trap finish EXIT
trap 'exit 1' HUP INT TERM
mkdir "$root" "$snap"
fstdev=$(fssconfig -l | awk '/^fss[0-9]+: not in use$/ { sub(/:$/, "", $1); print $1; exit }')
[ -n "$fstdev" ] || { echo 'No free FFS snapshot device' >&2; exit 1; }
fssconfig -x "$fstdev" / "$work/backing"
fst=$fstdev
mount -r -t ffs "/dev/$fst" "$snap"
snap_mounted=yes
newfs -O 1 "/dev/r${device##*/}"
mount -t ffs -o async "$device" "$root"
target_mounted=yes
mkfifo "$work/tree"
(cd "$snap" && exec tar --one-file-system -cpf - \
    --exclude './boot/?*' --exclude './tmp/?*' --exclude './proc/?*' \
    --exclude './dev/pts/?*' --exclude './var/tmp/?*' --exclude './var/run/?*' \
    --exclude './var/cache/?*' --exclude './var/shm/?*' \
    --exclude './var/db/ember-update/incoming' --exclude './var/db/ember-os-update/incoming' \
    --exclude './var/db/ember-os-update/attempt.json' --exclude './var/db/ember-update/attempt.json' \
    --exclude './var/db/emberbsd-sdk/client.lock' .) >"$work/tree" &
writer=$!
tar -xpf "$work/tree" -C "$root"
wait "$writer"
writer=
umount "$snap"
snap_mounted=
fssconfig -u "$fst"
fst=
/usr/libexec/ember-install-slot populate "$root" "$@"
chroot "$root" /bin/sh -ec '
    for dir in /boot /tmp /var/run /var/tmp; do test -d "$dir"; done
    test -x /usr/sbin/ember-update
    test -x /etc/rc.d/ember_update
    /usr/sbin/ember-update --help >/dev/null
    . /etc/rc.subr
    load_rc_config resize_root
    ! checkyesno resize_root || exit 1
    load_rc_config resize_gpt
    ! checkyesno resize_gpt || exit 1
'
sync
umount "$root"
target_mounted=
