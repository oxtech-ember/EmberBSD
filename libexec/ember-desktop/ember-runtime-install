#!/bin/sh
# SPDX-License-Identifier: BSD-2-Clause
# Install the verified base runtime with the system's ordinary target pkgtools.
set -eu
unset LD_LIBRARY_PATH LD_PRELOAD
PATH=/bin:/usr/bin:/sbin:/usr/sbin
export PATH
[ "$(id -u)" = 0 ] || exit 1
cache=/var/cache/ember-runtime
package=gcc16-runtime-16.2.0nb1
printf 'gcc16\n' | cmp -s - "$cache/PROFILE" || exit 1
printf '%s\n' "$package" | cmp -s - "$cache/ROOTS" || exit 1
IFS= read -r line < "$cache/SHA512"
expected=${line#SHA512 ($package.tgz) = }
[ "${#expected}" = 128 ] || exit 1
case $expected in *[!0-9a-f]*) exit 1;; esac
printf 'SHA512 (%s.tgz) = %s\n' "$package" "$expected" |
    cmp -s - "$cache/SHA512" || exit 1
[ -f "$cache/All/$package.tgz" ] && [ ! -L "$cache/All/$package.tgz" ] || exit 1
[ "$(/usr/bin/sha512 -q "$cache/All/$package.tgz")" = "$expected" ] || exit 1
PKG_DBDIR=/usr/pkg/pkgdb
PKG_PATH=$cache/All
export PKG_DBDIR PKG_PATH
for conflict in 'gcc16-[0-9]*' 'gcc16-libs-[0-9]*'; do
	if /usr/sbin/pkg_info -qe "$conflict"; then
		echo 'A different GCC runtime provider is installed.' >&2
		exit 1
	fi
done
/usr/sbin/pkg_add "$cache/All/$package.tgz"
/usr/sbin/pkg_info -qe "$package"
