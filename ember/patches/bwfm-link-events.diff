Origin: EmberBSD station disconnect recovery and regression, 2026-10-11.
Preserve Broadcom/OpenBSD authorship and licence in the modified source.
A physical CM5 loses its 2.4 GHz association while the host remains in RUN.
Subscribe to peer disconnect indications, process DEAUTH/DISASSOC, and use
LINK flags rather than status/reason to determine link direction. Ignore
stale peers, stopped/scanning stations and AP mode. Safe report metadata
supports physical verification without printing addresses or key material.
Reference semantics: Linux a5ebb76233b79db01e82e061173cb73c6d2b5c6b
brcmfmac/cfg80211.c and OpenBSD c27e9422e69bb315a6b6c6fbc4913e2a96c50796
sys/dev/ic/bwfm.c. See ember/boot/bwfm-link-events.md for validation limits.

diff --git a/sys/dev/ic/bwfm.c b/sys/dev/ic/bwfm.c
index c9fa890e060..e27974b3116 100644
--- a/sys/dev/ic/bwfm.c
+++ b/sys/dev/ic/bwfm.c
@@ -643,7 +643,9 @@ bwfm_init(struct ifnet *ifp)
 		ENABLE_EVENT(BWFM_E_AUTH);
 		ENABLE_EVENT(BWFM_E_ASSOC);
 		ENABLE_EVENT(BWFM_E_DEAUTH);
+		ENABLE_EVENT(BWFM_E_DEAUTH_IND);
 		ENABLE_EVENT(BWFM_E_DISASSOC);
+		ENABLE_EVENT(BWFM_E_DISASSOC_IND);
 		ENABLE_EVENT(BWFM_E_SET_SSID);
 		ENABLE_EVENT(BWFM_E_ESCAN_RESULT);
 		break;
@@ -1152,6 +1154,9 @@ bwfm_report_cb(struct bwfm_softc *sc)
 	    DEVNAME(sc), sc->sc_sae_enabled, sc->sc_sae_generation,
 	    sc->sc_sae_requests, sc->sc_sae_received, sc->sc_sae_sent,
 	    sc->sc_sae_dropped, sc->sc_sae_last_flags);
+	printf("%s: disconnect events %u last %u reason %u flags 0x%x\n",
+	    DEVNAME(sc), sc->sc_link_events, sc->sc_link_event,
+	    sc->sc_link_reason, sc->sc_link_flags);
 	if ((sc->sc_if.if_flags & IFF_RUNNING) == 0 || ic->ic_bss == NULL)
 		return;
 	error = bwfm_fwvar_cmd_get_data(sc, BWFM_C_GET_BSSID,
@@ -2736,16 +2741,26 @@ bwfm_rx_event_cb(struct bwfm_softc *sc, struct mbuf *m)
 		break;
 
 	case BWFM_E_LINK:
-		if (ntohl(e->msg.status) == BWFM_E_STATUS_SUCCESS &&
-		    ntohl(e->msg.reason) == 0)
+		/* The flags, not the reason code, describe link direction. */
+		if (ntohs(e->msg.flags) & BWFM_EVENT_MSG_LINK)
+			break;
+		/* FALLTHROUGH */
+	case BWFM_E_DEAUTH:
+	case BWFM_E_DEAUTH_IND:
+	case BWFM_E_DISASSOC:
+	case BWFM_E_DISASSOC_IND:
+		sc->sc_link_events++;
+		sc->sc_link_event = ntohl(e->msg.event_type);
+		sc->sc_link_reason = ntohl(e->msg.reason);
+		sc->sc_link_flags = ntohs(e->msg.flags);
+		if (ic->ic_opmode != IEEE80211_M_STA ||
+		    ic->ic_state <= IEEE80211_S_SCAN || ic->ic_bss == NULL)
 			break;
-		/* A previous BSSID may report link-down after a new join starts. */
-		if ((ic->ic_state == IEEE80211_S_AUTH ||
-		    ic->ic_state == IEEE80211_S_ASSOC) &&
-		    !IEEE80211_ADDR_EQ(&e->msg.addr, ic->ic_bss->ni_bssid))
+		/* Ignore a previous peer even after the new join reaches RUN. */
+		if (!IEEE80211_ADDR_EQ(&e->msg.addr, ic->ic_bss->ni_bssid))
 			break;
 
-		/* Link status has changed */
+		/* Firmware already disconnected; let the host scan and rejoin. */
 		ieee80211_new_state(ic, IEEE80211_S_SCAN, -1);
 		break;
 
diff --git a/sys/dev/ic/bwfmreg.h b/sys/dev/ic/bwfmreg.h
index 342a9339803..b0bc044199b 100644
--- a/sys/dev/ic/bwfmreg.h
+++ b/sys/dev/ic/bwfmreg.h
@@ -785,6 +785,7 @@ struct bwfm_ethhdr {
 struct bwfm_event_msg {
 	uint16_t version;
 	uint16_t flags;
+#define BWFM_EVENT_MSG_LINK		0x0001
 	uint32_t event_type;
 	uint32_t status;
 	uint32_t reason;
diff --git a/sys/dev/ic/bwfmvar.h b/sys/dev/ic/bwfmvar.h
index f75482fa21e..943c7fad69f 100644
--- a/sys/dev/ic/bwfmvar.h
+++ b/sys/dev/ic/bwfmvar.h
@@ -234,6 +234,11 @@ struct bwfm_softc {
 	uint32_t		 sc_sae_sent;
 	uint32_t		 sc_sae_dropped;
 	uint32_t		 sc_sae_last_flags;
+	/* Connection-event metadata only; no addresses or key material. */
+	uint32_t		 sc_link_events;
+	uint32_t		 sc_link_event;
+	uint32_t		 sc_link_reason;
+	uint16_t		 sc_link_flags;
 	bool			 sc_sae_enabled;
 	uint8_t			 sc_sae_bssid[IEEE80211_ADDR_LEN];
 
