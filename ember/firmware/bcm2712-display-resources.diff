Origin: EmberBSD native BCM2712 display resource contract.

Keep the legacy GPU0 memory and interrupt indices. Append each shared
display resource once and opt in with the versioned _DSD property.
This patch does not access MMIO, change clocks, or initialize HDMI.

--- a/Platform/RaspberryPi/RPi5/AcpiTables/Dsdt.asl
+++ b/Platform/RaspberryPi/RPi5/AcpiTables/Dsdt.asl
@@ -542,6 +542,14 @@
       Name (_UID, 0x0)
       Name (_CCA, 0x0)
 
+      // Versioned EmberBSD display resources. Keep the legacy 10/4 prefix.
+      Name (_DSD, Package () {
+        ToUUID ("daffd814-6eba-4d8c-8a91-bc9bbf4aa301"),
+        Package () {
+          Package () { "emberbsd,display-contract-version", One }
+        }
+      })
+
       Method (_STA) {
         Return (0xF)
       }
