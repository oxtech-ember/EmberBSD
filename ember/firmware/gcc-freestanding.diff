# Origin: EmberBSD, AI-assisted freestanding GCC16 profile.
# Base: edk2-platforms c4b5d05de1f2ef633bdb4c175b5c118fcb2666ed.
# Apply after the existing platform option diffs in series.
# EDK2 single '=' appends; preserve platform, tool and module flags.

--- a/Platform/RaspberryPi/RPi5/RPi5.dsc
+++ b/Platform/RaspberryPi/RPi5/RPi5.dsc
@@ -256,4 +256,16 @@
 [BuildOptions]
+!ifdef EMBER_FIRMWARE_ROOT
+  # Append the firmware profile. Keep tool and module flags, including LTO.
+  GCC:*_*_AARCH64_CC_FLAGS      = --sysroot=$(EMBER_FIRMWARE_ROOT) -ffreestanding -nostdinc -U__NetBSD__ -isystem$(EMBER_GCC_INCLUDE)
+  GCC:*_*_AARCH64_PP_FLAGS      = --sysroot=$(EMBER_FIRMWARE_ROOT) -ffreestanding -nostdinc -U__NetBSD__ -isystem$(EMBER_GCC_INCLUDE)
+  GCC:*_*_AARCH64_ASM_FLAGS     = --sysroot=$(EMBER_FIRMWARE_ROOT) -ffreestanding -nostdinc -U__NetBSD__ -isystem$(EMBER_GCC_INCLUDE)
+  GCC:*_*_AARCH64_VFRPP_FLAGS   = --sysroot=$(EMBER_FIRMWARE_ROOT) -ffreestanding -nostdinc -U__NetBSD__ -isystem$(EMBER_GCC_INCLUDE)
+  GCC:*_*_AARCH64_ASLPP_FLAGS   = --sysroot=$(EMBER_FIRMWARE_ROOT) -ffreestanding -nostdinc -U__NetBSD__ -isystem$(EMBER_GCC_INCLUDE)
+  GCC:*_*_AARCH64_ASLCC_FLAGS   = --sysroot=$(EMBER_FIRMWARE_ROOT) -ffreestanding -nostdinc -U__NetBSD__ -isystem$(EMBER_GCC_INCLUDE)
+  GCC:*_*_AARCH64_DTCPP_FLAGS   = --sysroot=$(EMBER_FIRMWARE_ROOT) -ffreestanding -nostdinc -U__NetBSD__ -isystem$(EMBER_GCC_INCLUDE)
+  GCC:*_*_AARCH64_DLINK_FLAGS   = --sysroot=$(EMBER_FIRMWARE_ROOT) -specs=$(EMBER_FIRMWARE_SPECS) -nostdlib -static -Wl,-nostdlib
+  GCC:*_*_AARCH64_ASLDLINK_FLAGS = --sysroot=$(EMBER_FIRMWARE_ROOT) -specs=$(EMBER_FIRMWARE_SPECS) -nostdlib -static -Wl,-nostdlib
+!endif
 !if $(RP1_UART_CONSOLE) == TRUE
 !if $(CM5_BOOT_TRACE) == TRUE
   GCC:*_*_*_CC_FLAGS          = -DRPI_MODEL=5 -DRP1_UART_CONSOLE -DCM5_BOOT_TRACE
