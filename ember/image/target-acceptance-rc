#!/bin/sh
# SPDX-License-Identifier: BSD-2-Clause
# Run the disposable target suite after the selected read-only FFS root mounts.
set -eu

fail()
{
	if [ -n "${nonce-}" ]; then
		echo "EMBERBSD-ACCEPTANCE $nonce FAIL $1"
	fi
	echo "target acceptance: $1" >&2
	/sbin/halt -p -q
	exit 1
}

nonce=$(cat /etc/emberbsd-target-acceptance.nonce 2>/dev/null || true)
case $nonce in ''|*[!A-Za-z0-9_-]*) fail invalid-nonce;; esac
root_device=$(cat /etc/emberbsd-target-acceptance-root-device 2>/dev/null || true)
case $root_device in ld*[a-p]) ;; *) fail invalid-root-device;; esac
root_unit=${root_device%?}
partition=${root_device#"$root_unit"}
unit_number=${root_unit#ld}
case $unit_number in ''|*[!0-9]*) fail invalid-root-device;; esac
partition_letters=abcdefghijklmnop
remaining=${partition_letters#*"$partition"}
expected_partition=$((15 - ${#remaining}))
actual_unit=$(LC_ALL=C /sbin/sysctl -n kern.root_device) || fail root-device-query
actual_partition=$(LC_ALL=C /sbin/sysctl -n kern.root_partition) || fail root-partition-query
[ "$actual_unit" = "$root_unit" ] && [ "$actual_partition" = "$expected_partition" ] ||
	fail unexpected-root-device

mount_output=$(LC_ALL=C /sbin/mount) || fail root-mount-query
mounted=$(printf '%s\n' "$mount_output" | LC_ALL=C awk '
	$2 == "on" && $3 == "/" {
		count++
		if ($4 != "type" || $5 != "ffs" ||
		    ($1 != "root_device" && $1 !~ /^\/dev\/ld[0-9]+[a-p]$/))
			exit 1
		line = $0
		if (line !~ / \([^()]+\)$/) exit 1
		sub(/^.* \(/, "", line)
		sub(/\)$/, "", line)
		n = split(line, options, /, */)
		for (i = 1; i <= n; i++)
			if (options[i] == "read-only") ro = 1
		if (!ro) exit 1
		device = $1
	}
	END { if (count != 1 || !ro) exit 1; print device " ffs ro" }
') ||
	fail root-mount-query
set -- $mounted
{ [ "$1" = root_device ] || [ "$1" = "/dev/$root_device" ]; } &&
	[ "$2" = ffs ] || fail unexpected-root-device
case ,$3, in *,ro,*) ;; *) fail root-is-not-read-only;; esac
echo "EMBERBSD-ACCEPTANCE $nonce ROOT /dev/$root_device $2 $3"
EMBERBSD_ACCEPTANCE_NONCE=$nonce
export EMBERBSD_ACCEPTANCE_NONCE

/sbin/mount -t tmpfs tmpfs /tmp || fail scratch-mount
mkdir -p /tmp/emberbsd-target-tests || fail scratch-create
cp -R /tests/. /tmp/emberbsd-target-tests/ || fail tests-copy
cd /tmp/emberbsd-target-tests || fail tests-directory
if ./run-target.sh --target aarch64 .; then
	echo "EMBERBSD-ACCEPTANCE $nonce COMPLETE"
	/sbin/halt -p -q
	exit 0
fi
fail guest-tests
