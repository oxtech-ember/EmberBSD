# SPDX-License-Identifier: BSD-2-Clause
# Explicit administrator opt-in. No account, key or configuration is created.
# Source this file after persistent root and entropy setup, before networking.

cix_ssh_start()
{
	_cix_ssh_etc=${cix_ssh_etc:-/etc/ssh}
	_cix_ssh_config=$_cix_ssh_etc/sshd_config
	if [ ! -e "$_cix_ssh_config" ] && [ ! -L "$_cix_ssh_config" ]; then
		return 0
	fi
	if [ ! -f "$_cix_ssh_config" ] || [ -L "$_cix_ssh_config" ] ||
	    [ "$(stat -f '%u:%Lp' "$_cix_ssh_config")" != '0:600' ]; then
		echo 'SSH: require a root-owned regular config with mode 0600.' >&2
		return 1
	fi
	if [ ! -d "$_cix_ssh_etc" ] || [ -L "$_cix_ssh_etc" ]; then
		return 1
	fi
	case $(stat -f '%u:%Lp' "$_cix_ssh_etc") in
	0:700|0:755)	;;
	*)	echo 'SSH: require a root-owned config directory, mode 0700 or 0755.' >&2
		return 1 ;;
	esac
	_cix_ssh_sbin=${cix_ssh_sbin:-/usr/sbin}
	_cix_ssh_libexec=${cix_ssh_libexec:-/usr/libexec}
	_cix_ssh_run=${cix_ssh_run:-/var/run}
	_cix_ssh_pts=${cix_ssh_pts:-/dev/pts}
	if [ "${cix_ssh_invoked:-0}" != 0 ] ||
	    [ -e "$_cix_ssh_run/sshd.pid" ] || [ -L "$_cix_ssh_run/sshd.pid" ]; then
		echo 'SSH: startup was attempted or a PID file exists; inspect it.' >&2
		return 1
	fi
	for _cix_ssh_program in "$_cix_ssh_sbin/sshd" \
	    "$_cix_ssh_libexec/sshd-session" "$_cix_ssh_libexec/sshd-auth"; do
		[ -x "$_cix_ssh_program" ] || return 1
	done
	[ -d "$_cix_ssh_pts" ] && [ ! -L "$_cix_ssh_pts" ] || return 1
	# Native validation also checks host keys and the privsep account/directory.
	"$_cix_ssh_sbin/sshd" -t -f "$_cix_ssh_config" || return 1
	# Native mount prints: SOURCE on MOUNTPOINT type FSTYPE [(flags)].
	# Reject unknown/duplicate entries instead of covering an existing mount.
	_cix_ssh_mounts=$(mount) || return 1
	_cix_ssh_type=$(printf '%s\n' "$_cix_ssh_mounts" |
	    awk -v point="$_cix_ssh_pts" '
	        NF && (NF < 5 || $2 != "on" || $4 != "type") {exit 1}
	        $3 == point {if (seen++) exit 1; print $5}') || return 1
	case $_cix_ssh_type in
	'')	mount_ptyfs ptyfs "$_cix_ssh_pts" || return 1 ;;
	ptyfs)	;;
	*)	echo 'SSH: conflicting PTY mount; inspect it.' >&2
		return 1 ;;
	esac
	# A failed daemon launch can have side effects. Do not launch twice here.
	cix_ssh_invoked=1
	"$_cix_ssh_sbin/sshd" -f "$_cix_ssh_config"
}
