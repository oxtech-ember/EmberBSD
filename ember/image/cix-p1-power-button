#!/bin/sh
# SPDX-License-Identifier: BSD-2-Clause
# Based on etc/powerd/scripts/power_button, NetBSD revision 1.3 (2003-11-01).
# Keep the native shutdown hooks and filesystem shutdown path.
case "${2}" in
pressed)
	umask 077
	lock=/var/run/cix-poweroff.pending
	if ! mkdir "$lock" 2>/dev/null; then
		[ -d "$lock" ] && exit 0
		echo 'power button: cannot create shutdown guard.' >&2
		exit 1
	fi
	echo "power button pressed on ${1}: requesting orderly poweroff" >&2
	if /sbin/shutdown -p now "power button pressed"; then
		exit 0
	fi
	echo 'power button: shutdown request failed; a later press can retry.' >&2
	rm -d "$lock"
	exit 1
	;;
released)
	exit 0
	;;
*)
	echo "power button: unsupported event ${2} on device ${1}" >&2
	exit 1
	;;
esac
