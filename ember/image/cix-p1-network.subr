# SPDX-License-Identifier: BSD-2-Clause
# Reduced CIX development root. Source this file from its startup script.
# This is independent of the full base-system rc.d implementation.

cix_network_stop()
{
	_cix_if=$1
	_cix_run=${cix_run:-/var/run}
	# dhcpcd has distinct IPv4-only and dual-stack PID files.
	dhcpcd -4 -k "$_cix_if" || :
	# WPA deinit restores AUTO roaming. Keep the interface DOWN first.
	ifconfig "$_cix_if" down || return 1
	wpa_cli -p "$_cix_run/wpa_supplicant" -i "$_cix_if" terminate || :
}

cix_network_start()
{
	_cix_if=$1
	_cix_config=$2
	_cix_run=${cix_run:-/var/run}
	_cix_log=${cix_log:-/var/log}
	if [ ! -f "$_cix_config" ] || [ -L "$_cix_config" ] ||
	    [ "$(stat -f '%u:%Lp' "$_cix_config")" != '0:600' ]; then
		echo 'Wi-Fi: require a root-owned regular profile with mode 0600.' >&2
		return 1
	fi
	if [ -e "$_cix_run/wpa_supplicant.pid" ]; then
		echo 'Wi-Fi: WPA PID file exists; inspect the running instance.' >&2
		return 1
	fi
	umask 077
	mkdir -p "$_cix_run/wpa_supplicant" "$_cix_log" || return 1
	: >> "$_cix_log/wpa_supplicant.log" || return 1
	chmod 600 "$_cix_log/wpa_supplicant.log" || return 1
	# Set manual roaming while DOWN. AUTO can select a BSS before WPA starts.
	ifconfig "$_cix_if" down || return 1
	ifconfig "$_cix_if" roaming manual || return 1
	ifconfig "$_cix_if" up || return 1
	if ! wpa_supplicant -B -Dbsd -i "$_cix_if" -c "$_cix_config" \
	    -O "$_cix_run/wpa_supplicant" -P "$_cix_run/wpa_supplicant.pid" \
	    -f "$_cix_log/wpa_supplicant.log"; then
		ifconfig "$_cix_if" down || :
		return 1
	fi
	# Return before association or DHCP completes. Both daemons retry later.
	# Keep the route and DNS hooks, but prevent a second WPA instance.
	if ! dhcpcd -b -4 -C wpa_supplicant "$_cix_if"; then
		ifconfig "$_cix_if" down || return 1
		wpa_cli -p "$_cix_run/wpa_supplicant" -i "$_cix_if" terminate || :
		return 1
	fi
}
