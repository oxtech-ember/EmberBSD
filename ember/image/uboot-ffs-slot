#!/usr/pkg/bin/python3.15 -I
# SPDX-License-Identifier: BSD-2-Clause
"""Install a verified OS cohort on the inactive FFS wedge of a U-Boot image."""

from contextlib import ExitStack
import hashlib
import json
import mmap
import os
from pathlib import Path
import re
import shutil
import subprocess
import sys
import tarfile
import tempfile


BOOT = Path('/boot')
STATE = Path('var/db/ember-os-update')
ROOTS = {'A': 'netbsd-root', 'B': 'ember-root-b'}
PROFILE = Path('/etc/ember-uboot-slots.json')
GOOD, BACK, NEXT = ('osgood.dat', 'osback.dat', 'osnext.dat')


def check(ok, message):
    if not ok:
        raise ValueError(message)


def output(*args):
    return subprocess.check_output(args, text=True).strip()


def run(*args, **kwargs):
    subprocess.run(args, check=True, **kwargs)


def marker(name):
    try:
        data = (BOOT / name).read_bytes()
    except FileNotFoundError:
        return None
    return {b'A': 'A', b'B': 'B'}.get(data)


def prepared():
    try:
        value = (BOOT / 'osplan.dat').read_bytes()
    except FileNotFoundError:
        return None
    match = re.fullmatch(rb'([AB]) ([0-9a-f]{64})\n', value)
    return dict(slot=match[1].decode(), sha256=match[2].decode()) if match else None


def write_plan(value):
    # Persist the preparation result independently of either root.
    path = BOOT / 'osplan.dat'
    with path.open('wb') as stream:
        stream.write(value)
        stream.flush()
        os.fsync(stream.fileno())
    check(path.read_bytes() == value, 'prepared slot receipt readback failed')


def record_prepared(slot, receipt):
    value = f'{slot} {hashlib.sha256(receipt).hexdigest()}\n'.encode()
    write_plan(value)


def write_marker(name, value):
    # Keep the loader's existing one-byte file. Do not rename a FAT directory entry.
    path = BOOT / name
    with path.open('r+b', buffering=0) as stream:
        check(os.fstat(stream.fileno()).st_size == 1, f'invalid loader marker: {name}')
        check(stream.write(value.encode('ascii')) == 1, 'short loader marker write')
        os.fsync(stream.fileno())
    check(path.read_bytes() == value.encode('ascii'), f'loader marker readback failed: {name}')


def layout(profile, *, provisioning=False):
    check(output('/sbin/sysctl', '-n', 'hw.model') == profile['model'], 'hardware profile mismatch')
    running = output('/sbin/sysctl', '-n', 'kern.root_device')
    match = re.fullmatch(r'(dk[0-9]+) at ([a-z]+[0-9]+): (.+)', output(
        '/sbin/dkctl', running, 'getwedgeinfo').splitlines()[0])
    check(match and match[1] == running, 'running root must be a disk wedge')
    devices = {}
    for line in output('/sbin/dkctl', match[2], 'listwedges').splitlines():
        item = re.fullmatch(r'(dk[0-9]+): ([^,]+), [0-9]+ blocks at [0-9]+, type: (\w+)', line)
        if item:
            check(item[2] not in devices, 'duplicate wedge label')
            devices[item[2]] = (item[1], item[3])
    mounts = output('/sbin/mount').splitlines()
    for label, fs, target in ((match[3], 'ffs', '/'), ('EFI', 'msdos', '/boot')):
        device = devices[label][0]
        check(any(line.startswith(f'/dev/{device} on {target} type {fs} (') for line in mounts),
              f'unexpected mount for {label}')
    slots = {s: devices[n][0] for s, n in ROOTS.items() if n in devices and devices[n][1] == 'ffs'}
    check(set(slots) == set(ROOTS) and running in slots.values(), 'two provisioned FFS slots required')
    active = next(s for s in slots if slots[s] == running)
    stable = marker(GOOD) or marker(BACK)
    check(stable in ROOTS or (provisioning and stable is None), 'confirmed boot marker is unavailable')
    chosen = output('/usr/sbin/ofctl', '-p', '/chosen')
    trial = re.search(r'^emberbsd,trial-watchdog(?:\s|$)', chosen, re.M) is not None
    return dict(running=active, confirmed=stable, next=marker(NEXT), trial=trial, prepared=prepared()), slots


def digest(stream):
    return hashlib.file_digest(stream, 'sha256').digest()


def member_id(item, archive):
    if item.isfile() or item.islnk():
        with archive.extractfile(item) as stream:
            return ('file', digest(stream), item.mode & 0o7777, item.uid, item.gid)
    if item.isdir():
        return ('dir', item.mode & 0o7777, item.uid, item.gid)
    if item.issym():
        return ('link', item.linkname, item.uid, item.gid)
    return None


def defaults(archive):
    with tarfile.open(archive, 'r:xz') as tar:
        result = {}
        for item in tar:
            path = Path(item.name)
            check(not path.is_absolute() and '..' not in path.parts, 'invalid defaults path')
            if path == Path('.'):
                continue
            identity = member_id(item, tar)
            if identity:
                result[path] = identity
        return result


def installed_id(root, relative):
    path = root / relative
    check(path.parent.resolve().is_relative_to(root), f'configuration parent escapes slot: {relative}')
    if path.is_symlink():
        return ('link', os.readlink(path), path.lstat().st_uid, path.lstat().st_gid)
    if path.is_file():
        with path.open('rb') as stream:
            info = os.fstat(stream.fileno())
            return ('file', digest(stream), info.st_mode & 0o7777, info.st_uid, info.st_gid)
    if path.is_dir():
        info = path.stat()
        return ('dir', info.st_mode & 0o7777, info.st_uid, info.st_gid)
    return None if not path.exists() else ('other',)


def merge_defaults(root, old_archive, new_archive):
    before, after = defaults(old_archive), defaults(new_archive)
    install, removed_dirs = [], []
    for path in sorted(before.keys() | after.keys()):
        old, new = before.get(path), after.get(path)
        if old == new:
            continue
        actual = installed_id(root, path)
        if actual == new:
            continue
        check(actual == old, f'local and release changes overlap: {path}')
        dest = root / path
        if new is None and old[0] == 'dir':
            removed_dirs.append(dest)
        elif new is None:
            dest.unlink()
        elif new[0] == 'dir':
            check(old is None or old[0] == 'dir', f'default changes filesystem type: {path}')
            dest.mkdir(parents=True, exist_ok=True)
            os.chown(dest, new[2], new[3])
            dest.chmod(new[1])
        else:
            check(old is None or old[0] != 'dir', f'default replaces a directory: {path}')
            install.append('./' + str(path))
    if install:
        names = b'\0'.join(os.fsencode(name) for name in install) + b'\0'
        run('/bin/tar', '-xpf', new_archive, '-C', root, '--null', '-T', '/dev/stdin', input=names)
    for dest in reversed(removed_dirs):
        if not any(dest.iterdir()):
            dest.rmdir()


def snapshot_copy(root, work, stack):
    source = work / 'snapshot'
    source.mkdir(mode=0o700)
    stack.callback(source.rmdir)
    free = re.search(r'^(fss\d+): not in use$', output('/usr/sbin/fssconfig', '-l'), re.M)
    check(free, 'no free FFS snapshot device')
    device = free[1]
    run('/usr/sbin/fssconfig', '-x', device, '/', str(work / 'backing'))
    stack.callback(run, '/usr/sbin/fssconfig', '-u', device)
    run('/sbin/mount', '-r', '-t', 'ffs', '/dev/' + device, source)
    stack.callback(run, '/sbin/umount', source)
    # Copy a consistent system, including pkgdb, accounts, DNS, SSH and firmware.
    # Mounted volumes retain their own storage and fstab entries.
    skip = ['boot', 'proc', 'dev/pts', 'tmp', 'var/tmp', 'var/run', 'var/shm',
            'var/cache', str(STATE / 'incoming'), str(STATE / 'attempt.json')]
    args = ['/bin/tar', '--one-file-system', '-cpf', '-']
    for path in skip:
        args.extend(('--exclude', './' + path + '/*'))
    # The package lock and OS journal contain process state from the running slot.
    args.extend(('--exclude', './' + str(STATE / 'attempt.json'),
                 '--exclude', './var/db/emberbsd-sdk/client.lock'))
    with subprocess.Popen([*args, '.'], cwd=source, stdout=subprocess.PIPE) as writer:
        try:
            run('/bin/tar', '-xpf', '-', '-C', root, stdin=writer.stdout)
        finally:
            writer.stdout.close()
        check(writer.wait() == 0, 'cannot copy the source snapshot')


def contains_build(path, commit, kernel_tag):
    """Check the selected kernel's image format, build identity and configuration."""
    with path.open('rb') as file, mmap.mmap(file.fileno(), 0, access=mmap.ACCESS_READ) as image:
        correct_format = image[56:60] == b'ARMd' if path.suffix == '.img' else image[:4] == b'\x7fELF'
        return (correct_format and image.find(kernel_tag.encode()) >= 0 and
                re.search(b'EmberBSD:' + commit.encode() + rb'\n?\x00', image) is not None)


def boot_file(archive, name, dest):
    member = archive.getmember(name)
    check(member.isfile() and member.size > 0, f'invalid boot file: {name}')
    check(not dest.is_symlink(), f'unexpected boot file link: {dest.name}')
    dest.parent.mkdir(parents=True, exist_ok=True)
    with archive.extractfile(member) as source, dest.open('wb') as target:
        shutil.copyfileobj(source, target)
        target.flush()
        os.fsync(target.fileno())


def prepare(profile, slot, device, directory):
    receipt = json.loads((directory / 'update.json').read_bytes())
    check(receipt['profile'] == profile['profile'], 'wrong OS profile')
    check(profile['kernel'] in output('/sbin/sysctl', '-n', 'kern.version').splitlines()[0], 'custom kernel holds OS updates')
    check(set(receipt['sets']) == set(profile['sets']), 'distribution set selection changed')
    check(not re.search(r'^/dev/' + device + r' on ', output('/sbin/mount'), re.M), 'target is mounted')
    # These wedges are dedicated to this profile. Rebuild an interrupted staging slot from scratch.
    write_plan(b'-\n')
    run('/sbin/newfs', '-O', '1', '/dev/r' + device)
    work = Path(tempfile.mkdtemp(prefix='ember-slot-', dir='/var/run'))
    with ExitStack() as stack:
        stack.callback(work.rmdir)
        root = work / 'target'
        root.mkdir(mode=0o700)
        stack.callback(root.rmdir)
        run('/sbin/mount', '-t', 'ffs', '/dev/' + device, root)
        stack.callback(run, '/sbin/umount', root)
        snapshot_copy(root, work, stack)
        # The native base supplies programs and libraries. Preserve site files and device firmware.
        run('/bin/tar', '-xpf', directory / 'base.tar.xz', '-C', root, '--safe-writes',
            '--exclude', './etc/*', '--exclude', './var/*', '--exclude', './usr/pkg',
            '--exclude', './usr/local', '--exclude', './libdata/firmware', '--exclude', './usr/libdata/firmware')
        run('/bin/tar', '-xpf', directory / 'base.tar.xz', '-C', root, '--safe-writes',
            './etc/release', './etc/mtree/set.base')
        if 'comp' in receipt['sets']:
            run('/bin/tar', '-xpf', directory / 'comp.tar.xz', '-C', root, '--safe-writes')
        state = root / STATE
        # Some profiles install the updater in an image layer over common sets.
        # This copy retains that layer until a release replaces its programs.
        merge_defaults(root, state / 'etc.tar.xz', directory / 'etc.tar.xz')
        shutil.copyfile(directory / 'etc.tar.xz', state / 'etc.tar.xz')
        fstab = root / 'etc/fstab'
        table = fstab.read_text()
        table, count = re.subn(r'(?m)^NAME=(?:netbsd-root|ember-root-b)(\s+/\s+ffs\s+)',
                               'NAME=' + ROOTS[slot] + r'\1', table)
        check(count == 1, 'expected one named FFS root in fstab')
        fstab.write_text(table)
        boot = BOOT if slot == 'A' else BOOT / 'os-b'
        modules = root / profile['module_directory']
        if modules.exists():
            check(modules.resolve().is_relative_to(root) and not modules.is_symlink(), 'invalid module directory')
            shutil.rmtree(modules)
        chosen_modules = {line.split('#', 1)[0].split()[0] for line in
                          (root / 'etc/modules.conf').read_text().splitlines() if line.split('#', 1)[0].strip()}
        check(chosen_modules <= set(profile['modules']), 'release cannot supply configured modules')
        with tarfile.open(directory / 'boot.tar.xz', 'r:xz') as archive:
            boot_file(archive, 'netbsd', root / 'netbsd')
            boot_file(archive, 'netbsd.img', boot / 'netbsd.img')
            for path in (root / 'netbsd', boot / 'netbsd.img'):
                check(contains_build(path, receipt['os_commit'], profile['kernel']),
                      f'{path.name} differs from the selected kernel release')
            for tree in profile['trees']:
                boot_file(archive, tree, boot / profile['tree_directory'] / tree)
            for module in profile['modules']:
                boot_file(archive, f'modules/{module}.kmod',
                          root / profile['module_directory'] / module / (module + '.kmod'))
        (state / 'attempt.json').unlink(missing_ok=True)
        shutil.copyfile(directory / 'update.json', state / 'release.json')
        run('/usr/sbin/chroot', root, '/bin/sh', '-ec',
            'test -x /etc/rc.d/ember_os_update && test -x /usr/libexec/ember-os-update && '
            '/usr/pkg/bin/python3.15 -I -c "import ssl" && '
            '. /etc/rc.subr && load_rc_config resize_root && ! checkyesno resize_root && '
            'load_rc_config resize_gpt && ! checkyesno resize_gpt')
        os.sync()
    record_prepared(slot, (directory / "update.json").read_bytes())


def read_profile():
    info = PROFILE.lstat()
    check(info.st_uid == 0 and not info.st_mode & 0o022 and PROFILE.is_file() and not PROFILE.is_symlink(),
          'unsafe boot profile owner, mode or type')
    profile = json.loads(PROFILE.read_bytes())
    check(set(profile) == {'profile', 'model', 'kernel', 'watchdog', 'trees', 'tree_directory', 'modules', 'module_directory', 'sets'},
          'unexpected U-Boot profile fields')
    for key, pattern in (('profile', r'[a-z0-9][a-z0-9._-]*'), ('watchdog', r'[a-z][a-z0-9]*'),
                         ('kernel', r'\([A-Za-z0-9_]+\)'), ('tree_directory', r'dtb(?:/[a-zA-Z0-9_-]+)*'),
                         ('module_directory', r'stand/[\w-]+/[0-9.]+/modules')):
        check(isinstance(profile[key], str) and re.fullmatch(pattern, profile[key]), f'invalid {key}')
    for key, pattern in [('trees', r'[a-zA-Z0-9_-]+\.dtb'), ('modules', r'[a-zA-Z0-9_]+')]:
        items = profile[key]
        check(isinstance(items, list) and all(isinstance(x, str) and re.fullmatch(pattern, x) for x in items),
              f'invalid {key}')
    check(profile['trees'] and set(profile['sets']) in ({'boot', 'base', 'etc'}, {'boot', 'base', 'etc', 'comp'}),
          'invalid boot trees or install sets')
    return profile


def main():
    args = sys.argv[1:]
    profile = read_profile()
    state, slots = layout(profile)
    if args == ['status']:
        print(json.dumps(state))
        return
    slot = args[1] if len(args) > 1 else None
    check(slot in ROOTS, 'expected slot A or B')
    if args == ['confirm', slot]:
        check(state['trial'] and state['running'] == slot and state['next'] is None,
              'expected a consumed trial of the running slot')
        identity = hashlib.sha256((Path('/') / STATE / 'release.json').read_bytes()).hexdigest()
        check(prepared() == dict(slot=slot, sha256=identity), 'current root differs from the prepared cohort')
        watchdog = re.escape(profile['watchdog'])
        check(re.search(r'^\s*' + watchdog + r', \d+ second period \[armed, external tickle\]$',
                        output('/sbin/wdogctl'), re.M), 'trial watchdog is unavailable')
        run('/sbin/wdogctl', '-d')
        try:
            write_marker(GOOD, slot)
        except (OSError, ValueError):
            # The old default still provides recovery when the first commit write fails.
            # Reboot after a readback error too: the installed default resolves the outcome.
            try:
                run('/sbin/wdogctl', '-e', '-p', '16', profile['watchdog'])
            finally:
                run('/sbin/shutdown', '-r', 'now')
            raise
        write_marker(BACK, slot)
        return
    if args == ['cancel', slot]:
        check(state['running'] == state['confirmed'] and state['running'] != slot and state['next'] == slot,
              'can only cancel an unconsumed trial on the confirmed slot')
        write_marker(NEXT, '-')
        return
    check(state['running'] == state['confirmed'] and state['running'] != slot and state['next'] is None,
          'operation requires an idle, confirmed root and an inactive target')
    if args[0] == 'prepare' and len(args) == 3:
        # Both recovery records must select this working system before reusing its peer.
        for name in (GOOD, BACK):
            if marker(name) != state['running']:
                write_marker(name, state['running'])
        prepare(profile, slot, slots[slot], Path(args[2]))
    elif args == ['arm', slot]:
        check(state['prepared'] and state['prepared']['slot'] == slot, 'slot has no prepared release')
        write_marker(NEXT, slot)
    else:
        raise ValueError('expected status, prepare SLOT DIR, arm SLOT, cancel SLOT or confirm SLOT')


if __name__ == '__main__':
    try:
        main()
    except (KeyError, OSError, ValueError, tarfile.TarError, subprocess.SubprocessError) as error:
        sys.exit(f'ember-os-slot: {error}')
