#!/bin/sh
# SPDX-License-Identifier: BSD-2-Clause
# Trusted UART console for this development profile. No network login service.
HOME=/root
TERM=${TERM:-vt100}
PATH=/sbin:/bin:/usr/sbin:/usr/bin
PS1='ember-cix# '
ENV=/etc/cix-console.env
export HOME TERM PATH PS1 ENV
cd /root || exit 1
exec /bin/sh -i
