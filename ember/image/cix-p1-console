#!/bin/sh
# SPDX-License-Identifier: BSD-2-Clause
# Trusted UART console for this development profile. No network login service.
HOME=/root
TERM=${TERM:-vt100}
PATH=/sbin:/bin:/usr/sbin:/usr/bin
PS1='ember-cix# '
export HOME TERM PATH PS1
cd /root || exit 1
# Retain getty's noninteractive session leader. Its TERM exit hangs up the TTY.
# The continuation also prevents a shell from replacing us with its last command.
/bin/sh -i
cix_console_status=$?
exit "$cix_console_status"
