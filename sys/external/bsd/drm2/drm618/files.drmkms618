#	Origin: EmberBSD (Linux 6.18 DRM core)
#
# DRM core of Linux 6.18 next to the 5.6 core of files.drmkms.  A kernel
# selects either drmkms (dist, 5.6) or drmkms618 (dist618, 6.18); both use
# the same Linux compatibility layer (drmkms_linux, drmkms_i2c).  See README.
#
# NOT included from sys/conf/files yet: the 6.18 sources do not compile
# (see tools/compile-map618.sh).  Do not add the include before the
# first kernel with drmkms618 builds.

define	drmkms618: drmkms_linux, drmkms_i2c, linux, sysmon_power

# Same as drmkms: Linux code assumes signed overflow is fine.
makeoptions	drmkms618	"COPTS.drmkms618"+="-fwrapv"

# Order matters: our headers for 6.18 first, then the Linux 6.18 headers, then
# the shared layer (include/linux, include/asm) and the common NetBSD headers.
# The 5.6 override directory drm2/include/drm is not used: a header with the
# same name must come from drm618/include or dist618/include.
makeoptions	drmkms618	"CPPFLAGS.drmkms618"+="-I$S/external/bsd/drm2/drm618/include"
makeoptions	drmkms618	"CPPFLAGS.drmkms618"+="-I$S/external/bsd/drm2/dist618/include"
makeoptions	drmkms618	"CPPFLAGS.drmkms618"+="-I$S/external/bsd/drm2/dist618/include/uapi"
makeoptions	drmkms618	"CPPFLAGS.drmkms618"+="-I$S/external/bsd/drm2/include"
makeoptions	drmkms618	"CPPFLAGS.drmkms618"+="-I$S/external/bsd/common/include"

makeoptions	drmkms618	"CPPFLAGS.drmkms618"+="-D__KERNEL__"

# Includes the Linux 6.18 sources expect from Linux's own include chains,
# see the header.
makeoptions	drmkms618	"CPPFLAGS.drmkms618"+="-include $S/external/bsd/drm2/drm618/include/drm618_prefix.h"

ifdef i386
makeoptions	drmkms618	"CPPFLAGS.drmkms618"+="-DCONFIG_X86"
makeoptions	drmkms618	"CPPFLAGS.drmkms618"+="-DCONFIG_X86_PAT"
elifdef amd64
makeoptions	drmkms618	"CPPFLAGS.drmkms618"+="-DCONFIG_X86"
makeoptions	drmkms618	"CPPFLAGS.drmkms618"+="-DCONFIG_X86_64"
makeoptions	drmkms618	"CPPFLAGS.drmkms618"+="-DCONFIG_X86_PAT"
elifdef aarch64
makeoptions	drmkms618	"CPPFLAGS.drmkms618"+="-DCONFIG_ARM64"
endif

# CONFIG_DRM_FBDEV_EMULATION is off: no Linux fb_info here; the files that need it
# (listed in tools/not-built.txt) are not built.  The console of a 6.18 driver
# is a drm client of its own (later phase).
makeoptions	drmkms618	"CPPFLAGS.drmkms618"+="-DCONFIG_FB=0"
makeoptions	drmkms618	"CPPFLAGS.drmkms618"+="-DCONFIG_LOCKDEP=0"
makeoptions	drmkms618	"CPPFLAGS.drmkms618"+="-DCONFIG_PCI=1"

makeoptions	drmkms618	"CWARNFLAGS.drmkms618"+="-Wno-missing-field-initializers"

# Either the 5.6 core or the 6.18 core, never both.
file	external/bsd/drm2/drm618/drm618_exclusive.c	drmkms618 & drmkms

# Own code of the 6.18 core (BSD-2-Clause, written to the Linux interface).
file	external/bsd/drm2/drm618/drm618_kthread_worker.c	drmkms618
file	external/bsd/drm2/drm618/drm618_managed.c	drmkms618
file	external/bsd/drm2/drm618/drm618_rbtree.c	drmkms618
file	external/bsd/drm2/drm618/drm618_statics.c	drmkms618

# Linux 6.18 files (MIT or dual licence), generated by prepare-import618.sh;
# keep in step with files.drmkms618.draft.  The GPL-only files listed in
# drm618/gpl-only.tsv are missing here until their BSD rewrites exist.
file	external/bsd/drm2/dist618/drm/clients/drm_client_setup.c		drmkms618
#file	external/bsd/drm2/dist618/drm/clients/drm_fbdev_client.c		drmkms618  (needs fbdev emulation)
file	external/bsd/drm2/dist618/drm/display/drm_display_helper_mod.c		drmkms618
