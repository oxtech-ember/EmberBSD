/*
 * Orange Pi Zero 4.
 *
 * The vendor boot loader hands over with the console UART and the
 * microSD pins already configured and the card powered.
 */

/dts-v1/;

#include "sun60i-a733.dtsi"

#include <dt-bindings/gpio/gpio.h>

/ {
	model = "OrangePi Zero 4";
	compatible = "xunlong,orangepi-zero4", "allwinner,sun60i-a733";

	aliases {
		serial0 = &uart0;
		serial1 = &uart1;
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};

	/*
	 * The enable pins of the AIC8800 wireless module: PM1 for the
	 * network half, PM2 for the Bluetooth half.
	 */
	/* Power of the Type-C data port, switched by PL8. */
	reg_usb3_vbus: regulator-usb3-vbus {
		compatible = "regulator-fixed";
		regulator-name = "usb3-vbus";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		gpio = <&r_pio 0 8 GPIO_ACTIVE_HIGH>;
		enable-active-high;
	};

	wifi_pwrseq: wifi-pwrseq {
		compatible = "mmc-pwrseq-simple";
		reset-gpios = <&r_pio 1 1 GPIO_ACTIVE_LOW>,
			      <&r_pio 1 2 GPIO_ACTIVE_LOW>;
	};

	/* The boot loader replaces the size with what it trained. */
	memory@40000000 {
		device_type = "memory";
		reg = <0x0 0x40000000 0x0 0x40000000>;
	};
};

/*
 * The MAC delays both RGMII clocks and the PHY adds nothing. Measured on
 * the board with 32 MiB of random data per 100 ps step: transmit works
 * from 0 to 1300 ps, receive from 1200 to 2700 ps. The values below are
 * the middles of those windows. The vendor's 1200 and 1000 ps sit on the
 * edge of the first window and outside the second.
 */
&gmac0 {
	phy-mode = "rgmii";
	phy-handle = <&ext_rgmii_phy>;
	pinctrl-names = "default";
	pinctrl-0 = <&gmac0_rgmii_pins>;
	allwinner,tx-delay-ps = <600>;
	allwinner,rx-delay-ps = <2000>;
	status = "okay";
};

&mdio0 {
	/* Motorcomm YT8531 */
	ext_rgmii_phy: ethernet-phy@1 {
		compatible = "ethernet-phy-ieee802.3-c22";
		reg = <1>;
	};
};

&mmc0 {
	pinctrl-names = "default";
	pinctrl-0 = <&mmc0_pins>;
	bus-width = <4>;
	/* The chip switches the supply of the card's pins to 1.8 V. */
	vqmmc-supply = <&reg_pf>;
	sd-uhs-sdr50;
	sd-uhs-sdr104;
	max-frequency = <150000000>;
	broken-cd;
	status = "okay";
};

/*
 * The AIC8800 wireless module. Its pins run at 1.8 V; the boot loader
 * leaves that supply on.
 */
&mmc1 {
	pinctrl-names = "default";
	pinctrl-0 = <&mmc1_pins>;
	bus-width = <4>;
	max-frequency = <50000000>;
	non-removable;
	mmc-pwrseq = <&wifi_pwrseq>;
	status = "okay";
};

/* Two USB 2.0 host ports; the boot loader leaves their power on. */
&usbphy {
	status = "okay";
};

&ehci0 {
	status = "okay";
};

&ohci0 {
	status = "okay";
};

&ehci1 {
	status = "okay";
};

&ohci1 {
	status = "okay";
};

/* The Type-C data port as a USB 2.0 host. */
&usb3_u2phy {
	status = "okay";
};

/*
 * The Type-C controller of the data port. It powers the port only while
 * a device is plugged in. Its interrupt line (PL9) is not described: the
 * pin controller has no interrupts, the driver polls.
 */
&r_i2c1 {
	status = "okay";

	typec@22 {
		compatible = "fcs,fusb302";
		reg = <0x22>;
		vbus-supply = <&reg_usb3_vbus>;

		connector {
			compatible = "usb-c-connector";
			label = "USB-C";
			data-role = "host";
			power-role = "source";
		};
	};
};

/* Origin: EmberBSD; enable the read-only firmware-ready GPU identity probe. */
&gpu {
	gpu-supply = <&reg_dcdc4>;
	status = "okay";
};

&combophy {
	status = "okay";
};

&usb3 {
	status = "okay";
};

/*
 * The power management chip. The vendor tree also lists an AXP515 at
 * 0x34; this board does not carry one.
 */
&r_i2c0 {
	status = "okay";

	pmic@36 {
		compatible = "x-powers,axp8191";
		reg = <0x36>;

		regulators {
			reg_dcdc1: dcdc1 {
				regulator-name = "dcdc1";
			};

			reg_dcdc2: dcdc2 {
				regulator-name = "dcdc2";
			};

			/* The big cores. */
			reg_dcdc3: dcdc3 {
				regulator-name = "dcdc3";
				regulator-min-microvolt = <800000>;
				regulator-max-microvolt = <1050000>;
			};

			reg_dcdc4: dcdc4 {
				regulator-name = "dcdc4";
			};

			/* The little cores. */
			reg_dcdc5: dcdc5 {
				regulator-name = "dcdc5";
				regulator-min-microvolt = <800000>;
				regulator-max-microvolt = <1050000>;
			};

			reg_dcdc6: dcdc6 {
				regulator-name = "dcdc6";
			};

			reg_dcdc7: dcdc7 {
				regulator-name = "dcdc7";
			};

			reg_dcdc8: dcdc8 {
				regulator-name = "dcdc8";
			};

			reg_dcdc9: dcdc9 {
				regulator-name = "dcdc9";
			};

			reg_dc1sw1: dc1sw1 {
				regulator-name = "dc1sw1";
			};

			reg_dc1sw2: dc1sw2 {
				regulator-name = "dc1sw2";
			};

			reg_aldo1: aldo1 {
				regulator-name = "aldo1";
			};

			reg_aldo2: aldo2 {
				regulator-name = "aldo2";
			};

			reg_aldo3: aldo3 {
				regulator-name = "aldo3";
			};

			reg_aldo4: aldo4 {
				regulator-name = "aldo4";
			};

			reg_aldo5: aldo5 {
				regulator-name = "aldo5";
			};

			reg_aldo6: aldo6 {
				regulator-name = "aldo6";
			};

			reg_bldo1: bldo1 {
				regulator-name = "bldo1";
			};

			reg_bldo2: bldo2 {
				regulator-name = "bldo2";
			};

			reg_bldo3: bldo3 {
				regulator-name = "bldo3";
			};

			reg_bldo4: bldo4 {
				regulator-name = "bldo4";
			};

			reg_bldo5: bldo5 {
				regulator-name = "bldo5";
			};

			reg_cldo1: cldo1 {
				regulator-name = "cldo1";
			};

			reg_cldo2: cldo2 {
				regulator-name = "cldo2";
			};

			reg_cldo3: cldo3 {
				regulator-name = "cldo3";
			};

			reg_cldo4: cldo4 {
				regulator-name = "cldo4";
			};

			reg_cldo5: cldo5 {
				regulator-name = "cldo5";
			};

			reg_dldo1: dldo1 {
				regulator-name = "dldo1";
			};

			reg_dldo2: dldo2 {
				regulator-name = "dldo2";
			};

			reg_dldo3: dldo3 {
				regulator-name = "dldo3";
			};

			reg_dldo4: dldo4 {
				regulator-name = "dldo4";
			};

			reg_dldo5: dldo5 {
				regulator-name = "dldo5";
			};

			reg_dldo6: dldo6 {
				regulator-name = "dldo6";
			};

			reg_eldo1: eldo1 {
				regulator-name = "eldo1";
			};

			reg_eldo2: eldo2 {
				regulator-name = "eldo2";
			};

			reg_eldo3: eldo3 {
				regulator-name = "eldo3";
			};

			reg_eldo4: eldo4 {
				regulator-name = "eldo4";
			};

			reg_eldo5: eldo5 {
				regulator-name = "eldo5";
			};

			reg_eldo6: eldo6 {
				regulator-name = "eldo6";
			};
		};
	};
};

/* Six little cores on one supply, two big ones on another. */
&cpu0 {
	operating-points-v2 = <&cluster0_opp_table>;
	cpu-supply = <&reg_dcdc5>;
};

&cpu1 {
	operating-points-v2 = <&cluster0_opp_table>;
	cpu-supply = <&reg_dcdc5>;
};

&cpu2 {
	operating-points-v2 = <&cluster0_opp_table>;
	cpu-supply = <&reg_dcdc5>;
};

&cpu3 {
	operating-points-v2 = <&cluster0_opp_table>;
	cpu-supply = <&reg_dcdc5>;
};

&cpu4 {
	operating-points-v2 = <&cluster0_opp_table>;
	cpu-supply = <&reg_dcdc5>;
};

&cpu5 {
	operating-points-v2 = <&cluster0_opp_table>;
	cpu-supply = <&reg_dcdc5>;
};

&cpu6 {
	operating-points-v2 = <&cluster1_opp_table>;
	cpu-supply = <&reg_dcdc3>;
};

&cpu7 {
	operating-points-v2 = <&cluster1_opp_table>;
	cpu-supply = <&reg_dcdc3>;
};

&uart0 {
	pinctrl-names = "default";
	pinctrl-0 = <&uart0_pb_pins>;
	status = "okay";
};

/* The Bluetooth half of the wireless module. */
&uart1 {
	pinctrl-names = "default";
	pinctrl-0 = <&uart1_pins>, <&uart1_rts_cts_pins>;
	uart-has-rtscts;
	auto-flow-control;
	status = "okay";
};
