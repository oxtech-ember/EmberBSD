/*
 * Allwinner A733 (sun60iw2).
 *
 * Addresses and interrupt numbers were checked against the vendor kernel
 * tree and, where a register could be read, on an Orange Pi Zero 4.
 */

#include <dt-bindings/interrupt-controller/arm-gic.h>
#include <dt-bindings/clock/allwinner,sun60i-a733-ccu.h>
#include <dt-bindings/clock/allwinner,sun60i-a733-r-ccu.h>
#include <dt-bindings/reset/allwinner,sun60i-a733-ccu.h>
#include <dt-bindings/reset/allwinner,sun60i-a733-r-ccu.h>
#include <dt-bindings/power/allwinner,sun60i-a733-pck-600.h>

/ {
	/* This frontend does not enable DE, clocks or output at attach. */
	display: display {
		compatible = "allwinner,sun60i-a733-display";
		display-engine = <&de0>;
		status = "disabled";
	};

	interrupt-parent = <&gic>;
	#address-cells = <2>;
	#size-cells = <2>;

	/*
	 * Rates and supply voltages per speed grade. Bit n of
	 * "opp-supported-hw" stands for the n-th of the grades 0x00, 0x01,
	 * 0x02, 0x03, 0x04, 0x05, 0x06, 0x14 and 0x15 in the EFUSE. A board
	 * points its cores here together with their supplies: without a
	 * supply the higher rates must not be used.
	 */
	cluster0_opp_table: opp-table-cluster0 {
		compatible = "allwinner,sun60i-a733-operating-points";
		opp-shared;

		opp-408-800 {
			opp-hz = /bits/ 64 <408000000>;
			opp-microvolt = <800000>;
			opp-supported-hw = <0x1ff>;
			clock-latency-ns = <2000000>;
		};

		opp-720-800 {
			opp-hz = /bits/ 64 <720000000>;
			opp-microvolt = <800000>;
			opp-supported-hw = <0x001>;
			clock-latency-ns = <2000000>;
		};

		opp-792-800 {
			opp-hz = /bits/ 64 <792000000>;
			opp-microvolt = <800000>;
			opp-supported-hw = <0x1fe>;
			clock-latency-ns = <2000000>;
		};

		opp-1008-800 {
			opp-hz = /bits/ 64 <1008000000>;
			opp-microvolt = <800000>;
			opp-supported-hw = <0x1ff>;
			clock-latency-ns = <2000000>;
		};

		opp-1104-800 {
			opp-hz = /bits/ 64 <1104000000>;
			opp-microvolt = <800000>;
			opp-supported-hw = <0x002>;
			clock-latency-ns = <2000000>;
		};

		opp-1200-800 {
			opp-hz = /bits/ 64 <1200000000>;
			opp-microvolt = <800000>;
			opp-supported-hw = <0x1fd>;
			clock-latency-ns = <2000000>;
		};

		opp-1200-850 {
			opp-hz = /bits/ 64 <1200000000>;
			opp-microvolt = <850000>;
			opp-supported-hw = <0x002>;
			clock-latency-ns = <2000000>;
		};

		opp-1296-800 {
			opp-hz = /bits/ 64 <1296000000>;
			opp-microvolt = <800000>;
			opp-supported-hw = <0x004>;
			clock-latency-ns = <2000000>;
		};

		opp-1296-900 {
			opp-hz = /bits/ 64 <1296000000>;
			opp-microvolt = <900000>;
			opp-supported-hw = <0x002>;
			clock-latency-ns = <2000000>;
		};

		opp-1392-800 {
			opp-hz = /bits/ 64 <1392000000>;
			opp-microvolt = <800000>;
			opp-supported-hw = <0x1a0>;
			clock-latency-ns = <2000000>;
		};

		opp-1392-840 {
			opp-hz = /bits/ 64 <1392000000>;
			opp-microvolt = <840000>;
			opp-supported-hw = <0x050>;
			clock-latency-ns = <2000000>;
		};

		opp-1392-850 {
			opp-hz = /bits/ 64 <1392000000>;
			opp-microvolt = <850000>;
			opp-supported-hw = <0x004>;
			clock-latency-ns = <2000000>;
		};

		opp-1392-860 {
			opp-hz = /bits/ 64 <1392000000>;
			opp-microvolt = <860000>;
			opp-supported-hw = <0x008>;
			clock-latency-ns = <2000000>;
		};

		opp-1392-950 {
			opp-hz = /bits/ 64 <1392000000>;
			opp-microvolt = <950000>;
			opp-supported-hw = <0x002>;
			clock-latency-ns = <2000000>;
		};

		opp-1416-800 {
			opp-hz = /bits/ 64 <1416000000>;
			opp-microvolt = <800000>;
			opp-supported-hw = <0x001>;
			clock-latency-ns = <2000000>;
		};

		opp-1512-820 {
			opp-hz = /bits/ 64 <1512000000>;
			opp-microvolt = <820000>;
			opp-supported-hw = <0x1a0>;
			clock-latency-ns = <2000000>;
		};

		opp-1512-880 {
			opp-hz = /bits/ 64 <1512000000>;
			opp-microvolt = <880000>;
			opp-supported-hw = <0x010>;
			clock-latency-ns = <2000000>;
		};

		opp-1512-900 {
			opp-hz = /bits/ 64 <1512000000>;
			opp-microvolt = <900000>;
			opp-supported-hw = <0x004>;
			clock-latency-ns = <2000000>;
		};

		opp-1512-1000 {
			opp-hz = /bits/ 64 <1512000000>;
			opp-microvolt = <1000000>;
			opp-supported-hw = <0x002>;
			clock-latency-ns = <2000000>;
		};

		opp-1608-840 {
			opp-hz = /bits/ 64 <1608000000>;
			opp-microvolt = <840000>;
			opp-supported-hw = <0x100>;
			clock-latency-ns = <2000000>;
		};

		opp-1608-860 {
			opp-hz = /bits/ 64 <1608000000>;
			opp-microvolt = <860000>;
			opp-supported-hw = <0x0a0>;
			clock-latency-ns = <2000000>;
		};

		opp-1608-900 {
			opp-hz = /bits/ 64 <1608000000>;
			opp-microvolt = <900000>;
			opp-supported-hw = <0x001>;
			clock-latency-ns = <2000000>;
		};

		opp-1608-920 {
			opp-hz = /bits/ 64 <1608000000>;
			opp-microvolt = <920000>;
			opp-supported-hw = <0x010>;
			clock-latency-ns = <2000000>;
		};

		opp-1608-950 {
			opp-hz = /bits/ 64 <1608000000>;
			opp-microvolt = <950000>;
			opp-supported-hw = <0x004>;
			clock-latency-ns = <2000000>;
		};

		opp-1608-1050 {
			opp-hz = /bits/ 64 <1608000000>;
			opp-microvolt = <1050000>;
			opp-supported-hw = <0x002>;
			clock-latency-ns = <2000000>;
		};

		opp-1704-860 {
			opp-hz = /bits/ 64 <1704000000>;
			opp-microvolt = <860000>;
			opp-supported-hw = <0x100>;
			clock-latency-ns = <2000000>;
		};

		opp-1704-900 {
			opp-hz = /bits/ 64 <1704000000>;
			opp-microvolt = <900000>;
			opp-supported-hw = <0x0a0>;
			clock-latency-ns = <2000000>;
		};

		opp-1704-960 {
			opp-hz = /bits/ 64 <1704000000>;
			opp-microvolt = <960000>;
			opp-supported-hw = <0x010>;
			clock-latency-ns = <2000000>;
		};

		opp-1704-1000 {
			opp-hz = /bits/ 64 <1704000000>;
			opp-microvolt = <1000000>;
			opp-supported-hw = <0x004>;
			clock-latency-ns = <2000000>;
		};

		opp-1800-900 {
			opp-hz = /bits/ 64 <1800000000>;
			opp-microvolt = <900000>;
			opp-supported-hw = <0x100>;
			clock-latency-ns = <2000000>;
		};

		opp-1800-950 {
			opp-hz = /bits/ 64 <1800000000>;
			opp-microvolt = <950000>;
			opp-supported-hw = <0x0a0>;
			clock-latency-ns = <2000000>;
		};

		opp-1800-1000 {
			opp-hz = /bits/ 64 <1800000000>;
			opp-microvolt = <1000000>;
			opp-supported-hw = <0x011>;
			clock-latency-ns = <2000000>;
		};

		opp-1800-1050 {
			opp-hz = /bits/ 64 <1800000000>;
			opp-microvolt = <1050000>;
			opp-supported-hw = <0x004>;
			clock-latency-ns = <2000000>;
		};
	};

