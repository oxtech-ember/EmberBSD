# Enable PCI resource support for Jasper Lake I2C BARs.
# Keep GENERIC_JSL_TRIAL as the display recovery kernel.

include "arch/amd64/conf/GENERIC_JSL_TRIAL"

options PCI_RESOURCE

# Windows Precision Touchpad contacts and optional single-finger tapping.
imt* at ihidev?
wsmouse* at imt? mux 0
