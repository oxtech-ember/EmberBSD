#
# ESP32S31 -- small RV32 kernel for boards with 16 MB of RAM
#
# The same kernel boots in QEMU virt: its devices stay in the list, and
# the console is the firmware one on both machines.
#

include	"arch/riscv/conf/std.riscv"
include	"arch/riscv/conf/files.generic"

maxusers 	2

options 	FDT
options		ESPTRNG

# The chip has F but no D; the kernel keeps no FPU state and is built
# without floating-point instructions.  User programs are soft-float.
makeoptions 	COPTS="-Os -fno-unwind-tables -fno-asynchronous-unwind-tables -march=rv32imac_zicsr_zifencei -mabi=ilp32"
makeoptions 	AOPTS="-march=rv32imac_zicsr_zifencei -mabi=ilp32"

no options 	AIO
no options 	MQUEUE
no options 	COREDUMP
no options 	PTRACE
no options 	PTRACE_HOOKS
no options 	SOC_SUN20I_D1
no options 	PCI_NETBSD_CONFIGURE
no options 	__HAVE_PCI_CONF_HOOK

options 	COMPAT_100	# Go still calls the NetBSD 10 kevent
options 	BUFCACHE=5	# percent of RAM for file system metadata
options 	PIPE_SOCKETPAIR	# smaller, but slower pipe(2)

file-system 	FFS
file-system 	TMPFS		# work files of the agent
options 	FFS_NO_SNAPSHOT

options 	INET		# IP + ICMP + TCP + UDP

config 		netbsd	root on ? type ?

mainbus0 	at root
simplebus* 	at fdt? pass 0

cpus* 		at fdt? pass 0
cpu* 		at fdt? pass 0
intc* 		at cpu? pass 1
fclock* 	at fdt? pass 1
syscon* 	at fdt? pass 1
plic* 		at fdt? pass 2
sbitty* 	at fdt?			# firmware console

# The chip: interrupts through the matrix and the CLIC, system timer
options 	RISCV_CLIC
espintmtx* 	at fdt? pass 2
espsystimer* 	at fdt?
espspi* 	at fdt? pass 3
spi* 		at espspi?
awge* 		at fdt?			# ESP32-S31 Ethernet
# Each receive slot holds a 2 KiB cluster: 256 of them would take 512 KiB.
# One descriptor per 64-byte cache line: the controller writes memory
# past the cache (see dwc_gmac_reg.h).
makeoptions 	CPPFLAGS+="-DAWGE_RX_RING_COUNT=32 -DAWGE_TX_RING_COUNT=32 -DAWGE_DESC_PAD=12"

# User space ends at 512 MB; the mask ROM and the internal RAM are mapped at
# their physical addresses above it, for the vendor's radio code.
makeoptions 	CPPFLAGS+="-DRISCV_LOW_IDMAP=0x20000000"
mcommphy* 	at mii? phy ?		# Motorcomm YT8531
ukphy* 		at mii? phy ?

# QEMU virt
gfrtc* 		at fdt?

virtio* 	at fdt?
ld* 		at virtio?
vioif* 		at virtio?
viornd* 	at virtio?

# The root file system is read in place from the flash window: the boot
# loader names its range as an initrd.
pseudo-device 	md
pseudo-device 	bpfilter	# the DHCP client of boardinit sends raw frames
options 	MEMORY_DISK_HOOKS
options 	MEMORY_DISK_DYNAMIC

pseudo-device 	loop
pseudo-device 	pty

options 	PAX_MPROTECT=0
options 	PAX_ASLR=0
