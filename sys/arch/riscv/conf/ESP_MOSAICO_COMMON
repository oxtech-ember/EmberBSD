# Shared ESP-Mosaico configuration.
include "arch/riscv/conf/ESP32S31"

# QEMU virt devices stay in ESP32S31 and its QEMU smoke-test profiles.
no gfrtc* 	at fdt?
no virtio* 	at fdt?
no ld* 		at virtio?
no vioif* 	at virtio?
no viornd* 	at virtio?

# Firmware UART remains the system console.
esp32s31_gpio* at fdt? pass 2
fregulator* at fdt? pass 3
gpioiic_fdt* at fdt? pass 4
iic* at gpioiic_fdt?
cst92xx* at iic? addr 0x5a
wsmouse* at cst92xx?
bq27220g* at iic?
bmm150g* at iic?
bmi270g* at iic?

# ESP32-S31 I2S audio and its AHB DMA provider.
espahbgdma* at fdt? pass 3
espi2s* at fdt? pass 4
es8311ac* at iic?             # Everest ES8311 codec
ausoc* at fdt?                # Simple SoC audio card
audio* at audiobus?

cofb* at spi? slave 0
wsdisplay* at wsemuldisplaydev?
options WSEMUL_VT100
options FONT_BOLD8x16
options WSDISPLAY_DEFAULTSCREENS=1
