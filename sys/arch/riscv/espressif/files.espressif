#	$NetBSD$
#
# Espressif SoC devices
#

# ESP32-S31 platform
file	arch/riscv/espressif/esp32s31_platform.c	espintmtx
file	arch/riscv/espressif/esp_rom.c			espintmtx

# SoC boot entropy, before the radio takes ownership of the noise source.
defflag opt_esptrng.h			ESPTRNG
file	arch/riscv/espressif/esp_trng.c		esptrng & espintmtx

# Radio of the ESP32-S31.  The vendor's libraries come in one object built
# by arch/riscv/espressif/wifi/mkblob; the kernel configuration names it.
defflag	opt_espwifi.h			ESPWIFI
defflag	opt_espwifi_net80211.h		ESPWIFI_NET80211: ESPWIFI, wlan
# Explicit opt-in for the unaccepted FullMAC WPA2 station association path.
defflag	opt_espwifi_wpa2.h		ESPWIFI_NET80211_WPA2: ESPWIFI_NET80211
file	arch/riscv/espressif/esp_wifi_os.c		espwifi
file	arch/riscv/espressif/esp_wifi_if.c		espwifi
file	arch/riscv/espressif/esp_wifi_subr.S		espwifi

# ESP32-S31 interrupt matrix and CLIC
device	espintmtx
attach	espintmtx at fdt
file	arch/riscv/espressif/esp_intmtx.c	espintmtx & riscv_clic

# ESP32-S31 system timer
device	espsystimer
attach	espsystimer at fdt
file	arch/riscv/espressif/esp_systimer.c	espsystimer

# ESP32-S31 general-purpose SPI, including half-duplex dual/quad writes.
device	espspi: spibus
attach	espspi at fdt
file	arch/riscv/espressif/esp_spi.c		espspi

# ESP32-S31 AXI peripheral DMA receive channels.
device	espaxigdma
attach	espaxigdma at fdt
file	arch/riscv/espressif/esp_axi_gdma.c		espaxigdma
file	arch/riscv/espressif/esp_axi_gdma_desc.c	espaxigdma

# ESP32-S31 DVP receiver on LCD_CAM, connected through the FDT media graph.
device	esp32s31dvp: videobus, fdt_port
attach	esp32s31dvp at fdt
file	arch/riscv/espressif/esp32s31_dvp.c	esp32s31dvp

# ESP32-S31 AHB peripheral DMA channels (I2S and other AHB requestors).
device	espahbgdma
attach	espahbgdma at fdt
file	arch/riscv/espressif/esp_ahb_gdma.c		espahbgdma
file	arch/riscv/espressif/esp_ahb_gdma_desc.c	espahbgdma

# ESP32-S31 I2S0 full-duplex audio interface.
device	espi2s: audiobus
attach	espi2s at fdt
file	arch/riscv/espressif/esp_i2s.c		espi2s

# ESP32-S31 Ethernet: DesignWare GMAC
attach	awge at fdt with esp_gmac
file	arch/riscv/espressif/esp_gmac.c		esp_gmac

# ESP32-S31 GPIO matrix and IO_MUX
device esp32s31_gpio
attach esp32s31_gpio at fdt
file arch/riscv/espressif/esp32s31_gpio.c esp32s31_gpio
