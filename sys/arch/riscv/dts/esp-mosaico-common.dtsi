#include "esp32s31.dtsi"
#include <dt-bindings/gpio/gpio.h>
#include "include/dt-bindings/pinctrl/esp32s31-pinctrl.h"

/ {
	model = "Espressif ESP-Mosaico";
	compatible = "espressif,esp-mosaico", "espressif,esp32s31",
	    "esp,esp32s31";
	aliases { serial0 = &uart0; };
	chosen { stdout-path = "serial0:115200n8"; };

	vcc_3v3: regulator-vcc-3v3 {
		compatible = "regulator-fixed";
		regulator-name = "VCC_3V3";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		gpio = <&gpio 60 GPIO_ACTIVE_LOW>;
		regulator-always-on;
		regulator-boot-on;
		startup-delay-us = <10000>;
	};

	/* 24 MHz XCLK for OV3640; SC101IOT modules provide their own XCLK. */
	camera_xclk: camera-xclk {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <24000000>;
		clock-output-names = "camera-xclk";
		status = "disabled";
	};

	/* Shared sensor bus; standard-mode GPIO I2C during bring-up. */
	i2c0: i2c {
		compatible = "i2c-gpio";
		#address-cells = <1>;
		#size-cells = <0>;
		sda-gpios = <&gpio 56 GPIO_OPEN_DRAIN>;
		scl-gpios = <&gpio 3 GPIO_OPEN_DRAIN>;

		touchscreen@5a {
			compatible = "hynitron,cst9220";
			reg = <0x5a>;
			power-supply = <&vcc_3v3>;
		};

		fuel-gauge@55 {
			compatible = "ti,bq27220";
			reg = <0x55>;
		};

		magnetometer@11 {
			compatible = "bosch,bmm150";
			reg = <0x11>;
		};

		magnetometer@12 {
			compatible = "bosch,bmm150";
			reg = <0x12>;
		};

		imu@69 {
			compatible = "bosch,bmi270";
			reg = <0x69>;
		};
	};

	/* Shared expansion-slot bus; does not claim slot-control pins. */
	i2c1: i2c-slots {
		compatible = "i2c-gpio";
		#address-cells = <1>;
		#size-cells = <0>;
		sda-gpios = <&gpio 0 GPIO_OPEN_DRAIN>;
		scl-gpios = <&gpio 1 GPIO_OPEN_DRAIN>;

		camera: camera@3c {
			compatible = "ovti,ov3640";
			reg = <0x3c>;
			reset-gpios = <&gpio 53 GPIO_ACTIVE_LOW>;
			powerdown-gpios = <&gpio 48 GPIO_ACTIVE_HIGH>;
			power-supply = <&vcc_3v3>;
			clocks = <&camera_xclk>;
			clock-names = "xclk";
			status = "disabled";
		};

		/* The SC101IOT module carries its own XCLK; its rate is unverified. */
		camera_sc101iot: camera@68 {
			compatible = "smartsens,sc101iot";
			reg = <0x68>;
			reset-gpios = <&gpio 53 GPIO_ACTIVE_LOW>;
			powerdown-gpios = <&gpio 48 GPIO_ACTIVE_HIGH>;
			power-supply = <&vcc_3v3>;
			status = "disabled";
			port {
				sensor_out: endpoint {
					remote-endpoint = <&dvp_in>;
				};
			};
		};
	};

	memory@50000000 {
		device_type = "memory";
		reg = <0x50000000 0x01000000>;
	};
};

&camera_dvp {
	status = "disabled";
	pinctrl-names = "default";
	pinctrl-0 = <&camera_dvp_pins>;
	port {
		dvp_in: endpoint {
			remote-endpoint = <&sensor_out>;
		};
	};
};

&gpio {
	status = "okay";

	lcd_pins: lcd-pins {
		control {
			pinmux = <ESP32S31_PINMUX(42, ESP32S31_SIG_NONE,
			    ESP32S31_SPI2_CLK)>,
			    <ESP32S31_PINMUX(50, ESP32S31_SIG_NONE,
			    ESP32S31_SPI2_CS)>;
			output-enable;
			bias-disable;
		};
		data {
			pinmux = <ESP32S31_PINMUX(36, ESP32S31_SPI2_D,
			    ESP32S31_SPI2_D)>,
			    <ESP32S31_PINMUX(51, ESP32S31_SPI2_Q,
			    ESP32S31_SPI2_Q)>,
			    <ESP32S31_PINMUX(35, ESP32S31_SPI2_WP,
			    ESP32S31_SPI2_WP)>,
			    <ESP32S31_PINMUX(9, ESP32S31_SPI2_HD,
			    ESP32S31_SPI2_HD)>;
			input-enable;
			output-enable;
			bias-disable;
		};
	};

	camera_dvp_pins: camera-dvp-pins {
		camera-inputs {
			pinmux = <ESP32S31_PINMUX(17, ESP32S31_CAM_PCLK,
			    ESP32S31_SIG_NONE)>,
			    <ESP32S31_PINMUX(19, ESP32S31_CAM_DE,
			    ESP32S31_SIG_NONE)>,
			    <ESP32S31_PINMUX(55, ESP32S31_CAM_VSYNC,
			    ESP32S31_SIG_NONE)>,
			    <ESP32S31_PINMUX(16, ESP32S31_CAM_DATA0,
			    ESP32S31_SIG_NONE)>,
			    <ESP32S31_PINMUX(15, ESP32S31_CAM_DATA1,
			    ESP32S31_SIG_NONE)>,
			    <ESP32S31_PINMUX(33, ESP32S31_CAM_DATA2,
			    ESP32S31_SIG_NONE)>,
			    <ESP32S31_PINMUX(4, ESP32S31_CAM_DATA3,
			    ESP32S31_SIG_NONE)>,
			    <ESP32S31_PINMUX(14, ESP32S31_CAM_DATA4,
			    ESP32S31_SIG_NONE)>,
			    <ESP32S31_PINMUX(12, ESP32S31_CAM_DATA5,
			    ESP32S31_SIG_NONE)>,
			    <ESP32S31_PINMUX(18, ESP32S31_CAM_DATA6,
			    ESP32S31_SIG_NONE)>,
			    <ESP32S31_PINMUX(13, ESP32S31_CAM_DATA7,
			    ESP32S31_SIG_NONE)>;
			input-enable;
			bias-disable;
		};
	};
};

&spi2 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&lcd_pins>;

	display@0 {
		compatible = "chipone,co5300";
		reg = <0>;
		spi-max-frequency = <40000000>;
		spi-tx-bus-width = <4>;
		width = <480>;
		height = <480>;
		reset-gpios = <&gpio 44 GPIO_ACTIVE_LOW>;
		power-supply = <&vcc_3v3>;
		/*
		 * Panel setup from esp-mosaico-bsp display.c, Apache-2.0,
		 * commit 7cbfb390638dcb93522fc3cde094b2d43cf907c2.
		 * Records: command, count, delay-ms (BE16), parameters.
		 * MADCTL=0, RGB565; TE is unused by the polling renderer.
		 */
		chipone,init-sequence = [
			36 01 00 00 00
			3a 01 00 00 55
			11 00 02 58
			fe 01 00 00 20
			19 01 00 00 10
			1c 01 00 00 a0
			fe 01 00 00 00
			c4 01 00 00 80
			3a 01 00 00 55
			53 01 00 00 20
			51 01 00 00 ff
			63 01 00 00 ff
			2a 04 00 00 00 00 01 df
			2b 04 00 00 00 00 01 df
			29 00 02 58
		];
	};
};
