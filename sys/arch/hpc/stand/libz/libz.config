#!/bin/sh
# $NetBSD: libz.config,v 1.9 2011/09/23 16:00:15 nonaka Exp $

# config file/script to generate project file (.dsp/.vcp) for libz

TYPE=static_library

NAME='libz'
SRCFILE_LIST='
	$(EMBER_ZLIB_SOURCE)\adler32.c
	$(EMBER_ZLIB_SOURCE)\crc32.c
	$(EMBER_ZLIB_SOURCE)\inffast.c
	$(EMBER_ZLIB_SOURCE)\inflate.c
	$(EMBER_ZLIB_SOURCE)\inftrees.c
	$(EMBER_ZLIB_SOURCE)\uncompr.c
	zalloc.c
'
CPPDEF_LIST='
	_STANDALONE
	ZLIB_NETBSD_STANDALONE
	__STDC__
	__COMPILER_INT64__=__int64
	__COMPILER_UINT64__="unsigned#__int64"
	__VA_LIST_DECLARED
	__builtin_va_list="char#*"
'
INCDIR_LIST='
	.
	$(EMBER_ZLIB_SOURCE)
	../include
	../../../..
'
LIBDEP_LIST=''
LIBRARY_LIST=''
