# Origin: EmberBSD BCM2712 V3D observation, 2026-10-09.
#	General AArch64 kernel with the EmberBSD device attachments.
#
#	vmt(4) is left out: its VMware backdoor probe traps under QEMU's HVF
#	and panics the kernel before the disk is found, and none of our
#	machines is VMware. Without it the build machine runs at full speed.

include	"arch/evbarm/conf/GENERIC64"

#	Show the EmberBSD boot splash on genfb framebuffers. The path is
#	relative to ${S}, so it also resolves for kernel objects built outside
#	the source tree; a framebuffer smaller than the image keeps the console.
options 	SPLASHSCREEN
makeoptions	SPLASHSCREEN_IMAGE="${S}/../ember/boot/emberbsd-boot-splash.png"

no vmt0	at cpu0

#	The Cadence GEM Ethernet of the Raspberry Pi 5 and CM5, through RP1
#	(../patches/cemac-acpi.diff). Do not load if_cemac_acpi.kmod with it.
cemac*		at acpi?

#	The BCM2712's power management, reset and watchdog block, which our
#	firmware describes in ACPI (../firmware/pm-watchdog.diff).
bcmpmwdog*	at acpi?
bcmv3d*		at acpi?		# Passive identification, no GPU commands

#	The Raspberry Pi 4 on its own device tree: the PCIe bridge its USB-A
#	ports sit behind, and the hardware random number generator
#	(../patches/bcm2838rng-bcm2711.diff). GENERIC64 has neither.
#	Not yet tried on a Pi 4.
bcm2838pcie*	at fdt?
bcm2838rng*	at fdt?

#	The AICSemi AIC8800D80 wireless module of the Orange Pi Zero 4
#	(../patches/aicwf.diff). Its firmware is not part of the tree.
aicwf*		at sdmmc?

#	Realtek RTL8822CE on Orange Pi 6 Plus. Attach maps BAR/IRQ only;
#	bus mastering and radio stay off until firmware bootstrap is accepted.
rtwce*		at pci?

#	CIX P1: a known DSDT selects the DEBUG UART2 console, also when SPCR
#	is absent or describes UART3. Other systems keep the SPCR console.
options 	CIXP1_UART2_CONSOLE

# CIX P1 codec resources only; power, MMIO, DMA and video stay disabled.
cixclk*		at acpi?		# Passive checked CCLK provider registration.
cixreset*	at acpi?		# Passive RST0 mapping; no reset operations.
#	cixvpu flags 0x0 describes the resources only. The flags 0x1 rate
#	query fails on UEFI V1.4 and V1.5: the CCLK GCLK channel gets SCMI
#	NOT_FOUND for clock 67. See sys/dev/acpi/docs/cix-platform.md.
cixvpu*		at acpi? flags 0x0 # Describe resources; do not activate the VPU.
cixgpio*	at acpi? flags 0x1	# Bounded GPI4 pin6 ACPI event; 0x0 is passive.

#	The power management chip of the Orange Pi Zero 4: its power key
#	(../patches/sun60i-a733.diff).
axp8191pm*	at iic?
axp8191reg*	at axp8191pm?
fusbtc*		at iic?			# FUSB302 USB Type-C controller

# Serial Bluetooth transport; UART description and firmware are board-specific.
pseudo-device	btuart

# Touchscreen, volume keys and audio on supported tablets.
gt9xx*		at iic?
wsmouse*	at gt9xx? mux 1
sunxilradc*	at fdt?
a133codec*	at fdt?

# RTL8723DS attaches only to a matching SDIO function and host profile.
rtwsdio*	at sdmmc?
