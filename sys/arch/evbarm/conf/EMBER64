# Origin: EmberBSD BCM2712 V3D observation, 2026-10-09.
#	Our aarch64 kernel: NetBSD 11.0 GENERIC64 plus what the Raspberry Pi 5
#	needs (patches in ../patches).
#
#	vmt(4) is left out: its VMware backdoor probe traps under QEMU's HVF
#	and panics the kernel before the disk is found, and none of our
#	machines is VMware. Without it the build machine runs at full speed.

include	"arch/evbarm/conf/GENERIC64"

no vmt0	at cpu0

#	The stand stays at securelevel -1 while the Ethernet driver is being
#	written: it is loaded and unloaded as a module on a running board,
#	and a module that panics costs a reboot into this kernel, not a card
#	taken back to the laptop. Goes when cemac is built in.
options 	INSECURE

#	The BCM2712's power management, reset and watchdog block, which our
#	firmware describes in ACPI (../firmware/pm-watchdog.diff).
bcmpmwdog*	at acpi?
bcmv3d*		at acpi?		# Passive identification, no GPU commands

#	The Raspberry Pi 4 on its own device tree: the PCIe bridge its USB-A
#	ports sit behind, and the hardware random number generator
#	(../patches/bcm2838rng-bcm2711.diff). GENERIC64 has neither.
#	Not yet tried on a Pi 4.
bcm2838pcie*	at fdt?
bcm2838rng*	at fdt?

#	The AICSemi AIC8800D80 wireless module of the Orange Pi Zero 4
#	(../patches/aicwf.diff). Its firmware is not part of the tree.
aicwf*		at sdmmc?

#	The power management chip of the Orange Pi Zero 4: its power key
#	(../patches/sun60i-a733.diff).
axp8191pm*	at iic?
axp8191reg*	at axp8191pm?
fusbtc*		at iic?			# FUSB302 USB Type-C controller

# Serial Bluetooth transport; UART description and firmware are board-specific.
pseudo-device	btuart
