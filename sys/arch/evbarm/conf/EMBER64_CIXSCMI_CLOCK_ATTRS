# Explicit CIX native SCMI CLOCK protocol attributes diagnostic. One request only.
# Keep the VPU inactive. Do not query a clock ID, rate or extended name.
# Use a manual boot entry and preserve a working recovery kernel.

include "arch/evbarm/conf/EMBER64_CIXSCMI_QUERY"

no cixscmi* at acpi?
cixscmi* at acpi? flags 0x4
