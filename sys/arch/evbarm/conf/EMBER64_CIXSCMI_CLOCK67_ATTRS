# Explicit CIX native SCMI clock67 attributes diagnostic. One request only.
# Keep the VPU inactive. Do not query a rate or extended name, or clear ACK.
# Use a manual boot entry and preserve a working recovery kernel.

include "arch/evbarm/conf/EMBER64_CIXSCMI_QUERY"

no cixscmi* at acpi?
cixscmi* at acpi? flags 0x8
