{
  "format": "emberbsd-native-bootstrap-component",
  "version": 1,
  "name": "filetime",
  "origin": "EmberBSD (AI-assisted). Complete canonical OS file-time reachover.",
  "initial_only": true,
  "source_makefile": "tools/compat/Makefile",
  "source_fragment": "tools/compat/filetime.mk",
  "sources": [
    "lib/libc/gen/utimens.c"
  ],
  "headers": [
    "tools/compat/compat_filetime.h",
    "tools/compat/namespace.h",
    "tools/compat/bootstrap_cdefs.h"
  ],
  "provenance": [
    "tools/compat/README.filetime.md",
    "tools/compat/configure.ac",
    "tools/compat/configure",
    "tools/compat/nbtool_config.h.in",
    "tools/compat/compat_defs.h"
  ],
  "required_tool_roles": [
    "cc",
    "ar",
    "ranlib"
  ],
  "control": "tools/compat/probes/filetime-control.c",
  "check": "tools/compat/probes/filetime-check.c",
  "probes": [
    {
      "name": "func-utimens",
      "source": "tools/compat/probes/func-utimens.c",
      "macro": "HAVE_UTIMENS"
    },
    {
      "name": "func-lutimens",
      "source": "tools/compat/probes/func-lutimens.c",
      "macro": "HAVE_LUTIMENS"
    }
  ],
  "config_preamble": "/* Actual file-time probes only; not a full OS configuration. */\n#ifndef EMBERBSD_FILETIME_CONFIG_H\n#define EMBERBSD_FILETIME_CONFIG_H\n#include \"bootstrap_cdefs.h\"\n#define HAVE_NBTOOL_CONFIG_H 1\n",
  "config_postamble": "#include \"compat_filetime.h\"\n#endif\n",
  "archive": "libnbcompat.a"
}
