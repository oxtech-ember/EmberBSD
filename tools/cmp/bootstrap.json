        "same.txt"
      ],
      "stdin": "",
      "exit": 2,
      "stdout": "",
      "stderr_nonempty": true
    },
    {
      "name": "invalid-option",
      "invocation": "cmp",
      "args": [
        "-z",
        "same.txt",
        "same.txt"
      ],
      "stdin": "",
      "exit": 2,
      "stdout": "",
      "stderr_nonempty": true
    },
    {
      "name": "stdin-twice",
      "invocation": "cmp",
      "args": [
        "-",
        "-"
      ],
      "stdin": "abc\n",
      "exit": 2,
      "stdout": "",
      "stderr_nonempty": true
    }
  ]
}
